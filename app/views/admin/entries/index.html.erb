<div class="admin-dashboard entry-table" data-controller="entry-table">
  <header class="admin-header">
    <h1 class="admin-title">All entries</h1>
    <p class="admin-subtitle">
      <%= number_with_delimiter(@entries.size) %> entries across every channel.
      Point at a row to watch, edit or delete it.
    </p>
  </header>

  <%# `table-layout: fixed` with widths set here: the browser sizes every column from this
      row alone instead of measuring every cell of every row first, which on a table this
      long is most of the time it takes to draw. %>
  <table class="entry-table__table">
    <colgroup>
      <col class="et-col-name"><col class="et-col-list"><col class="et-col-media">
      <col class="et-col-length"><col class="et-col-source"><col class="et-col-stream">
    </colgroup>
    <thead>
      <tr>
        <%= entry_table_heading 'Name', 'name', sort: @sort, direction: @direction %>
        <%= entry_table_heading 'Channel', 'list', sort: @sort, direction: @direction %>
        <%= entry_table_heading 'Media', 'media', sort: @sort, direction: @direction %>
        <%= entry_table_heading 'Runtime', 'length', sort: @sort, direction: @direction %>
        <%= entry_table_heading 'Source', 'source', sort: @sort, direction: @direction %>
        <%= entry_table_heading 'Stream', 'stream', sort: @sort, direction: @direction %>
      </tr>
    </thead>
    <%# Delegated from here rather than bound per row: one listener for the whole table, and
        rows a save or a delete redraws need nothing re-attached. focusin as well as
        mouseover, so a keyboard reaches the actions too. %>
    <tbody data-action="mouseover->entry-table#reveal focusin->entry-table#reveal">
      <%= render partial: 'admin/entries/row', collection: @entries, as: :entry %>
    </tbody>
  </table>

  <%# The row actions, once for the whole table. entry-table moves this into the row being
      pointed at and points the links at that entry, filling in ENTRY_ID. Parked in a hidden
      holder until the first row asks for it. %>
  <div hidden>
    <span class="et-act" data-entry-table-target="actions">
      <a href="#" data-template="<%= watch_entry_path('ENTRY_ID') %>" title="Watch"><i class="fa-solid fa-play"></i></a>
      <a href="#" data-template="<%= edit_admin_entry_path('ENTRY_ID') %>" data-turbo-frame="entry_table_edit" title="Edit"><i class="fa-solid fa-pen"></i></a>
      <a href="#" data-template="<%= admin_entry_path('ENTRY_ID') %>" data-turbo-method="delete" data-turbo-confirm="Delete this entry?" title="Delete" data-entry-table-target="delete"><i class="fa-solid fa-trash"></i></a>
    </span>
  </div>

  <%# The one edit modal for the whole table. Its body is a frame the row pencils aim at, so
      pressing one fetches that entry's form into it; entry-table opens the modal once the
      form has arrived, and closes it again when a save succeeds. %>
  <div class="modal fade" id="entryTableEditModal" tabindex="-1"
       aria-labelledby="entryTableEditTitle" aria-hidden="true"
       data-entry-table-target="modal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="entryTableEditTitle">Edit entry</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <turbo-frame id="entry_table_edit" data-entry-table-target="frame"></turbo-frame>
        </div>
      </div>
    </div>
  </div>
</div>
