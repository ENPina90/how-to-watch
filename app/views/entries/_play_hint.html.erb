<%# Only for providers that gate the player behind a click of their own. Everything else
    either autoplays or shows its own controls, and a hint over those would be a lie. %>
<div class="cinema__play-hint"
     data-controller="play-hint"
     data-play-hint-adapter-value="<%= adapter %>"
     data-play-hint-frame-value="cinema">
  <i class="fa-solid fa-play"></i>
  <span>Press play to start</span>
</div>
