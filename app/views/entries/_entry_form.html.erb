<div class="modal-content modal-placement">
  <div class="modal-header">
    <h5 class="modal-title" id="editModal<%= entry.id %>Label">Modal title</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <div class="modal-body">
    <%= simple_form_for(entry) do |f|%>
      <%= f.input :list_id, collection: @user_lists, selected: entry.list.id %>
      <%= f.input :position %>
      <%= f.input :name %>
      <%= f.input :media %>
      <%= f.input :source_url, label: "Source URL",
            input_html: { value: entry.current_source_url },
            hint: "Google Drive, mega, YouTube or archive.org link — or any direct URL. Leave blank for entries that play from an IMDb id." %>
      <%= f.association :provider,
            collection: Source.active.order(:position),
            label_method: ->(s) { "#{s.name} (#{s.kind})" },
            include_blank: "— Inherit channel default —",
            label: "Source provider" %>
      <%= f.input :source_key,
            label: "Source key / URL",
            hint: "Direct providers only: Drive file id, mega key#fragment, YouTube id, or full URL for Custom. Leave blank for imdb providers." %>
      <%= f.input :pic, label: "Poster URL (or upload below)" %>

      <% if entry.poster.attached? %>
        <div class="mb-3">
          <label class="form-label">Current Poster</label>
          <div>
            <img src="<%= entry.poster.url %>" class="img-thumbnail" style="max-width: 200px; max-height: 300px;" alt="Current Poster">
          </div>
        </div>
      <% end %>

      <%= f.input :poster, as: :file, label: "Upload New Poster Image", hint: "Replaces current poster if uploaded" %>
      <%= f.input :series %>
      <%= f.input :plot %>
      <%= f.input :imdb %>
      <%= f.input :category %>
      <%= f.input :note %>
      <% if entry.media == 'episode' %>
        <%= f.input :season %>
        <%= f.input :episode %>
      <% end %>
      <% if entry.media == 'series' || entry.media == 'anime' %>
        <h3>Episodes</h3>
        <%= f.simple_fields_for :subentries do |subentry_form| %>
          <%= subentry_form.input :name %>
          <%= subentry_form.input :plot %>
          <%= subentry_form.input :season %>
          <%= subentry_form.input :episode %>
          <%= subentry_form.input :_destroy, as: :boolean, label: 'Remove Subentry' %>
        <% end %>
      <% end %>
      <%= f.button :submit, class: 'btn-action', data: { bs_dismiss: "modal" }, aria_label: "Close" %>
    <% end %>
  </div>
</div>
