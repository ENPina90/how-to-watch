<%# One review modal for the whole list page. It used to be rendered per entry, which on
    a 1,200-entry list meant 1,200 modals, 1,200 forms (each with its own CSRF token) and
    1,200 identical copies of the rating script. The entry arrives with the Bootstrap
    trigger (entries/_completion_status) as `event.relatedTarget`, and the controller
    rewrites the form action and the two link hrefs before the modal opens. %>
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel"
     aria-hidden="true"
     data-controller="review-modal"
     data-review-modal-target="modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reviewModalLabel" data-review-modal-target="title">
          <i class="fa-solid fa-star text-warning me-2"></i>
          How was it?
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: "#", method: :patch, data: { turbo: true, review_modal_target: "form" } do |f| %>
        <div class="modal-body">
          <div class="mb-4">
            <label class="form-label">Rating (1-10)</label>
            <div class="d-flex justify-content-between align-items-center">
              <span class="text-muted">Poor</span>
              <div class="rating-stars mx-3">
                <% (1..10).each do |rating| %>
                  <i class="fa-regular fa-star star-rating"
                     data-review-modal-target="star"
                     data-rating="<%= rating %>"
                     data-action="click->review-modal#selectRating"
                     style="cursor: pointer; color: #ddd; font-size: 1.5rem;"></i>
                <% end %>
              </div>
              <span class="text-muted">Excellent</span>
            </div>
            <%= f.hidden_field :review, data: { review_modal_target: "rating" } %>
            <div class="text-center mt-2">
              <span data-review-modal-target="ratingDisplay" class="badge bg-secondary">No rating selected</span>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :comment, "Comments (optional)", class: "form-label" %>
            <%= f.text_area :comment,
                class: "form-control",
                rows: 3,
                data: { review_modal_target: "comment" } %>
          </div>
        </div>

        <div class="modal-footer">
          <a href="#" class="btn btn-outline-secondary me-auto"
             data-review-modal-target="dontAsk"
             data-turbo-method="patch"
             data-bs-dismiss="modal">
            <i class="fa-solid fa-ban me-1"></i> Don't ask again
          </a>
          <a href="#" class="btn btn-secondary"
             data-review-modal-target="skip"
             data-turbo-method="patch"
             data-bs-dismiss="modal">
            <i class="fa-solid fa-forward me-1"></i> Skip
          </a>
          <%= f.submit "Submit Review",
              class: "btn btn-primary submit-review-btn",
              data: { review_modal_target: "submit", bs_dismiss: "modal" },
              disabled: true %>
        </div>
      <% end %>
    </div>
  </div>
</div>
