  <%= turbo_frame_tag dom_id(entry) do %>
  <div class="card-container">
    <%# if entry.note %>
    <%# end %>
    <div class="grid-card" id="<%= entry.id %>">
      <div class="card-picture">
        <%= link_to watch_entry_path(entry), data: { turbo: false } do %>
          <%= entry_poster_image_tag(entry) %>
          <span class="fa-stack fa-4x play-button">
            <i class="fa-solid fa-circle fa-stack-2x icon-background"></i>
            <i class="fa-solid fa-play fa-stack-1x icon-foreground"></i>
          </span>
        <% end %>
      </div>
      <div class="card-stuff">
        <div class="card-title">
          <h5 class="card-header"><bold><%= entry.name %></bold></h5>
        </div>

        <!-- Episode Navigation Section -->
        <% current_subentry = entry.current_subentry_for_user(current_user) %>
        <div class="episode-navigation d-flex align-items-center justify-content-between border-top border-bottom py-3">
          <%= link_to decrement_current_entry_path(entry), class: 'text-decoration-none episode-nav-btn', data: { turbo_method: :patch } do %>
            <i class="fa-solid fa-2x fa-chevron-left"></i>
          <% end %>

          <div class="current-episode-info text-center flex-grow-1 mx-3">
            <div class="episode-label mb-1">
              <strong>S<%= current_subentry&.season %>E<%= current_subentry&.episode %></strong>
            </div>
            <div class="episode-name text-truncate" style="font-size: 0.9rem;">
              <%= current_subentry&.name %>
            </div>
          </div>

          <%= link_to increment_current_entry_path(entry), class: 'text-decoration-none episode-nav-btn', data: { turbo_method: :patch } do %>
            <i class="fa-solid fa-2x fa-chevron-right"></i>
          <% end %>
        </div>

        <div class="card-details">
          <div class="d-flex justify-content-between">
            <p><%= entry.year %></p>
            <p><%= entry.rating %></p>
          </div>
          <p class="mb-4"><small><%= entry.genre %></small></p>
          <p class="card-plot"><%= current_subentry&.plot.present? ? current_subentry.plot : entry.plot %></p>
        </div>
        <div class="card-menu">
          <% if entry.trailer.present? %>
            <a href="#" data-bs-toggle="modal" data-bs-target="#trailerModal"
               data-trailer-url="<%= convert_to_embed_url(entry.trailer) %>"
               data-trailer-name="<%= entry.name %>">
              <i class="fa-solid fa-trailer"></i>
            </a>
          <% end %>
          <%= render 'entries/completion_status', entry: entry, user: current_user %>
          <% if current_user&.can_edit_entry?(entry) %>
            <%= render 'shared/poster_selector_button', entry: entry %>
            <i class="fa-solid fa-pen" data-bs-toggle="modal" data-bs-target="#editModal" data-id="<%= entry.id %>" data-action="click->edit#toggle"></i>
            <%# <%= link_to edit_entry_path(entry) do %>
              <%# <i class="fa-solid fa-pen"></i> %>
              <%# <% end %>
            <%= link_to entry_path(entry),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                params: { source: 'index' } do %>
              <i class="fa-solid fa-trash"></i>
            <% end %>

            <% end %>
            <i class="fa-solid fa-link-slash"
        style="color:<%= entry.stream ? "grey" : "red"%>"
        title="Report broken link"
        data-controller="link"
        data-link-id-value="<%= entry.id %>"
        data-action="click->link#toggle"></i>
            <%= link_to duplicate_entry_path(entry), data: { turbo_method: :post } do %>
              <i class="fa-sharp fa-regular fa-plus" title="Add to another list"></i>
            <% end %>
          </div>
        </div>
      </div>
      <% if entry.trailer.present? %>
      <% end %>

    </div>
<% end %>
