<%# Making an entry by hand: a fanedit, a personal cut, a rip, a recording -- anything the
    metadata APIs describe badly or not at all. There is no search box on this page any
    more. The navbar search is on every page and its "+ Details" button lands here with the
    form already filled in from the API, so the one search does both jobs instead of this
    page carrying a second one that only worked here. %>
<div class="container">
  <div class="row justify-content-center layout-title">
    <h1 class="text-center">
      <%= render 'lists/header_count', count: @list.entries.count, list: @list %>
      - <%= link_to @list.name, list_path(@list) %>
    </h1>

    <%# Where the Movie/Series/Anime tabs used to be. They chose which search box to draw,
        and there is no search box left to choose between. %>
    <div class="new-entry-actions" data-controller="csv-upload">
      <%# Outside the form it submits, by id: the button belongs up here with the other two
          and the fields belong below, and an HTML form attribute is the whole of what that
          takes. %>
      <%= button_tag type: 'submit', form: 'custom-entry-form', class: 'btn btn-primary' do %>
        <i class="fa-solid fa-plus me-1"></i>Create Entry
      <% end %>

      <%# A file download rather than a page, so Turbo is told to stay out of it: a visit it
          cannot render leaves the page looking as though the click did nothing. %>
      <%= link_to csv_template_list_entries_path(@list), class: 'btn btn-outline-primary', data: { turbo: false } do %>
        <i class="fa-solid fa-file-arrow-down me-1"></i>Download CSV
      <% end %>

      <%# The picker is the button. A bare file input sitting in a row of buttons reads as a
          different kind of control from the two beside it, and it needs a second click to
          do anything. %>
      <%= form_with url: import_csv_list_entries_path(@list), multipart: true,
                    data: { turbo: false, csv_upload_target: 'form' }, class: 'd-inline' do %>
        <%= file_field_tag :file, accept: '.csv,text/csv',
              class: 'd-none',
              data: { csv_upload_target: 'input', action: 'change->csv-upload#submit' } %>
        <button type="button" class="btn btn-outline-primary" data-action="click->csv-upload#choose">
          <i class="fa-solid fa-file-arrow-up me-1"></i>Upload CSV
        </button>
      <% end %>
    </div>

    <p class="new-entry-hint">
      Download the CSV for a blank sheet with a column for every field below, the channels
      you can file a row into, and the media types that are allowed. Fill it in, upload it,
      and every row becomes an entry in <strong><%= @list.name %></strong> — or in whichever
      channel its <code>channel</code> cell names. A row with an <code>imdb</code> id has the
      rest looked up for it, and anything you typed wins over what the lookup said.
      <%= EntryCsvImporter::MAX_ROWS %> rows to an upload.
    </p>
  </div>

  <div class="row justify-content-center list-layout">
    <div class="col-8">
      <%= simple_form_for([@list, @entry], custom: true, html: { id: 'custom-entry-form' }) do |f| %>
        <%= f.input :list_id, label: 'Channel', collection: @user_lists, selected: @entry.list_id || @list.id %>
        <%= f.input :name %>
        <%# The values the app can actually draw: `entries/entry_#{media}` is a partial name,
            so an entry saved as anything outside this set has no card. The two that were
            offered here before -- `show` and `other` -- were both outside it. %>
        <%= f.input :media, collection: [['Fanedit', 'fanedit'], ['Movie', 'movie'], ['Series', 'series'], ['Anime', 'anime'], ['Episode', 'episode']] %>
        <%= f.input :source_url, label: 'Source URL',
              input_html: { value: @entry.current_source_url },
              hint: 'Google Drive, mega, YouTube or archive.org link — or any direct URL. Leave blank for entries that play from an IMDb id.' %>

        <%# Three ways to the same picture, and they are not the same thing. `pic` points at
            somebody else's host for as long as it stays up -- which is what the
            broken-poster audit spends its time finding out about -- while the two below keep
            a copy. The prefill fills `pic` with whatever the API had. %>
        <%= f.input :pic, label: 'Poster URL (linked, not stored)' %>
        <%= f.input :poster_url, as: :url, label: 'Fetch a poster from a link',
              input_html: { value: nil, placeholder: 'https://…' },
              hint: 'Downloads the image and keeps a copy, so it does not go dead later.' %>
        <%= f.input :poster, as: :file, label: 'Upload a poster image' %>

        <%= f.input :imdb, label: 'IMDb id', hint: 'Entries with no source URL play from this.' %>
        <%= f.input :tmdb, label: 'TMDB id' %>
        <%= f.input :year %>
        <%# What the cable schedule lays a slot out by. Left blank it falls back to a flat
            guess, and a guess that is short cuts the programme off partway through. %>
        <%= f.input :length, label: 'Runtime (minutes)',
              hint: 'Used by the cable schedule. Left blank it guesses, and a short guess cuts the programme off.' %>
        <%= f.input :series %>
        <%= f.input :season %>
        <%= f.input :episode %>
        <%= f.input :category %>
        <%= f.input :genre %>
        <%= f.input :rating %>
        <%= f.input :director %>
        <%= f.input :writer %>
        <%= f.input :actors %>
        <%= f.input :plot %>
        <%= f.input :note %>
        <%= f.input :review %>
        <%= hidden_field_tag :custom, true %>
        <%# No submit down here: Create Entry at the top of the page is this form's, by id. %>
      <% end %>
    </div>
  </div>
</div>
