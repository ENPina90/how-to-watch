<%# Making an entry by hand: a fanedit, a personal cut, a rip, a recording -- anything the
    metadata APIs describe badly or not at all. There is no search box on this page any
    more. The navbar search is on every page and its "+ Details" button lands here with the
    form already filled in from the API, so the one search does both jobs instead of this
    page carrying a second one that only worked here. %>
<%# And this is the only page that offers it: the button fills in the form below, and the
    result templates in the layout draw it only where a page has asked. %>
<% content_for :search_offers_details, 'yes' %>
<div class="container">
  <div class="row justify-content-center layout-title">
    <h1 class="text-center">
      <%# The channel page's number, nested channels included. The search above adds to this
          channel in place, and what comes back replaces this count with that one -- so a
          different number here jumped the moment anything was added. %>
      <%= render 'lists/header_count', count: @list.total_entry_count, list: @list %>
      - <%= link_to @list.name, list_path(@list) %>
    </h1>

    <%# Two buttons in the channel page's ruled action row, wearing its subscribe pill. Create
        is the large one because one entry at a time is what most visits here are for; the
        spreadsheet and the playlist are folded behind Bulk Create until asked for. %>
    <div class="new-entry-actions">
      <%# Outside the form it submits, by id: the button belongs up here and the fields belong
          below, and an HTML form attribute is the whole of what that takes. %>
      <%= button_tag type: 'submit', form: 'custom-entry-form', class: 'new-entry-pill new-entry-pill--primary' do %>
        <i class="fa-solid fa-plus"></i>Create Entry
      <% end %>

      <%# Bootstrap's collapse, which application.js already imports for the modals and
          dropdowns, so opening a panel needs no controller of its own. %>
      <button type="button" class="new-entry-pill"
              data-bs-toggle="collapse" data-bs-target="#new-entry-bulk"
              aria-controls="new-entry-bulk" aria-expanded="<%= @bulk_open %>">
        <i class="fa-solid fa-layer-group"></i>Bulk Create
      </button>
    </div>

    <div id="new-entry-bulk" class="collapse new-entry-bulk<%= ' show' if @bulk_open %>">
      <div class="new-entry-bulk__inner">
        <div class="new-entry-bulk__buttons" data-controller="csv-upload">
          <%# A file download rather than a page, so Turbo is told to stay out of it: a visit it
              cannot render leaves the page looking as though the click did nothing. %>
          <%= link_to csv_template_list_entries_path(@list), class: 'new-entry-pill new-entry-pill--small', data: { turbo: false } do %>
            <i class="fa-solid fa-file-arrow-down"></i>Download CSV
          <% end %>

          <%# The picker is the button. A bare file input beside a button reads as a different
              kind of control, and it needs a second click to do anything. %>
          <%= form_with url: import_csv_list_entries_path(@list), multipart: true,
                        data: { turbo: false, csv_upload_target: 'form' }, class: 'd-inline' do %>
            <%= file_field_tag :file, accept: '.csv,text/csv',
                  class: 'd-none',
                  data: { csv_upload_target: 'input', action: 'change->csv-upload#submit' } %>
            <button type="button" class="new-entry-pill new-entry-pill--small" data-action="click->csv-upload#choose">
              <i class="fa-solid fa-file-arrow-up"></i>Upload CSV
            </button>
          <% end %>
        </div>

        <p class="new-entry-hint">
          Download the CSV for a blank sheet with a column for every field below, the channels
          you can file a row into, and the media types that are allowed. Fill it in, upload it,
          and every row becomes an entry in <strong><%= @list.name %></strong> — or in whichever
          channel its <code>channel</code> cell names. A row with an <code>imdb</code> id has the
          rest looked up for it, and anything you typed wins over what the lookup said.
          <%= EntryCsvImporter::MAX_ROWS %> rows to an upload.
        </p>

        <%# Its own row rather than another button: it needs somewhere to paste. Turbo is left
            on so the button can say it is working -- the import reads the whole playlist
            inside the request, which is a few seconds for a long one. %>
        <%= form_with url: import_youtube_list_entries_path(@list), class: 'new-entry-youtube' do %>
          <%= url_field_tag :playlist_url, nil, class: 'form-control', required: true,
                placeholder: 'https://www.youtube.com/playlist?list=…',
                aria: { label: 'YouTube playlist link' } %>
          <%= button_tag type: 'submit', class: 'new-entry-pill new-entry-pill--small',
                data: { turbo_submits_with: 'Importing…' } do %>
            <i class="fa-brands fa-youtube"></i>Import Playlist
          <% end %>
        <% end %>

        <p class="new-entry-hint">
          Paste a YouTube playlist and every video in it becomes an entry in
          <strong><%= @list.name %></strong>, with its title, runtime, thumbnail and description.
          A title numbered like <code>S1 EP1</code> is filed as an episode. Import it again later
          and only the new videos are added.
        </p>
      </div>
    </div>
  </div>

  <div class="row justify-content-center list-layout">
    <div class="col-8">
      <%= simple_form_for([@list, @entry], custom: true, html: { id: 'custom-entry-form' }) do |f| %>
        <%= f.input :list_id, label: 'Channel', collection: @user_lists, selected: @entry.list_id || @list.id %>
        <%= f.input :name %>
        <%# The values the app can actually draw: `entries/entry_#{media}` is a partial name,
            so an entry saved as anything outside this set has no card. The two that were
            offered here before -- `show` and `other` -- were both outside it. %>
        <%= f.input :media, collection: [['Fanedit', 'fanedit'], ['Movie', 'movie'], ['Series', 'series'], ['Anime', 'anime'], ['Episode', 'episode']] %>
        <%= f.input :source_url, label: 'Source URL',
              input_html: { value: @entry.current_source_url },
              hint: 'Google Drive, mega, YouTube or archive.org link — or any direct URL. Leave blank for entries that play from an IMDb id.' %>

        <%# Three ways to the same picture, and they are not the same thing. `pic` points at
            somebody else's host for as long as it stays up -- which is what the
            broken-poster audit spends its time finding out about -- while the two below keep
            a copy. The prefill fills `pic` with whatever the API had. %>
        <%= f.input :pic, label: 'Poster URL (linked, not stored)' %>
        <%= f.input :poster_url, as: :url, label: 'Fetch a poster from a link',
              input_html: { value: nil, placeholder: 'https://…' },
              hint: 'Downloads the image and keeps a copy, so it does not go dead later.' %>
        <%= f.input :poster, as: :file, label: 'Upload a poster image' %>

        <%= f.input :imdb, label: 'IMDb id', hint: 'Entries with no source URL play from this.' %>
        <%= f.input :tmdb, label: 'TMDB id' %>
        <%= f.input :year %>
        <%# What the cable schedule lays a slot out by. Left blank it falls back to a flat
            guess, and a guess that is short cuts the programme off partway through. %>
        <%= f.input :length, label: 'Runtime (minutes)',
              hint: 'Used by the cable schedule. Left blank it guesses, and a short guess cuts the programme off.' %>
        <%= f.input :series %>
        <%= f.input :season %>
        <%= f.input :episode %>
        <%= f.input :category %>
        <%= f.input :genre %>
        <%= f.input :rating %>
        <%= f.input :director %>
        <%= f.input :writer %>
        <%= f.input :actors %>
        <%= f.input :plot %>
        <%= f.input :note %>
        <%= f.input :review %>
        <%= hidden_field_tag :custom, true %>
        <%# No submit down here: Create Entry at the top of the page is this form's, by id. %>
      <% end %>
    </div>
  </div>
</div>
