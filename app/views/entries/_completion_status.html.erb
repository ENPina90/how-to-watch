<%# Rendered once per card, so everything here is paid ~1,200 times on the big lists:
    no inline styles, no HTML comments (they ship to the browser), and no attribute that
    can be derived from the entry id. See §6.1 of docs/ARCHITECTURE.md. %>
<%# Marking something watched is a write against an account. Signed out there is nothing
    to mark, and `completed_by?(nil)` falls back to the entry's legacy flag -- somebody
    else's opinion -- so the control is left out entirely rather than shown wrong. %>
<% if user %>
<div id="completed-<%= entry.id %>" data-controller="completed" data-completed-id-value="<%= entry.id %>" class="completion-status">
  <% if entry.completed_by?(user) %>
    <%# Already watched: toggle straight back, no review prompt. %>
    <i class="fa-solid fa-2x fa-eye clickable text-decoration-none"
       title="Mark as unwatched"
       data-action="click->completed#toggle"></i>
  <% elsif entry.list.reviewable && (entry.media == 'movie' || entry.media == 'fanedit') %>
    <%# Opens the one shared review modal; it builds its own URLs from the entry id. %>
    <i class="fa-regular fa-2x fa-eye clickable text-decoration-none"
       title="Mark as watched and review"
       data-bs-toggle="modal"
       data-bs-target="#reviewModal"
       data-entry-id="<%= entry.id %>"
       data-entry-name="<%= entry.name %>"
       data-entry-media="<%= entry.media %>"></i>
  <% else %>
    <i class="fa-regular fa-2x fa-eye clickable text-decoration-none"
       title="Mark as watched"
       data-action="click->completed#toggle"></i>
  <% end %>

  <% if !local_assigns[:minimal] && entry.review_count > 0 %>
    <div class="mt-1">
      <small class="text-muted">
        <i class="fa-solid fa-star text-warning"></i>
        <%= entry.average_review&.round(1) || "N/A" %>
        (<%= pluralize(entry.review_count, 'review') %>)
      </small>
    </div>
  <% end %>
</div>
<% end %>
