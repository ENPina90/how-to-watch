<%= render 'shared/player_preconnect', url: @embed_url, source: @entry.resolved_source %>
<%= render "shared/entries_sidebar" %>
<script nonce="<%= content_security_policy_nonce %>">
  // Add has-entries-sidebar class to body
  document.body.classList.add('has-entries-sidebar');

  // Prevent iframe from navigating parent page or opening multiple windows
  let autoplayAttempts = 0;
  const originalOpen = window.open;
  window.open = function(...args) {
    console.log('window.open intercepted:', args);
    // Block repeated autoplay attempts
    return null;
  };

  // Prevent iframe from reloading parent.
  //
  // The test is "does the frame have focus", which is true for most of a film -- so a
  // navigation the page itself starts is caught by it too, and the browser asks the
  // viewer whether they meant to leave. That is fine for a hijack and wrong for the
  // up-next card, whose whole job is to leave: the prompt appears behind the countdown
  // and nothing happens. Anything in the app that navigates on purpose says so first.
  window.addEventListener('beforeunload', function(e) {
    if (window.leavingOnPurpose) return;

    if (document.activeElement && document.activeElement.tagName === 'IFRAME') {
      e.preventDefault();
      e.returnValue = '';
      return '';
    }
  });
</script>

<%# Position tracking rides on the same player reports the room does, and only providers
    with an adapter send any -- on the rest the controller connects and finds nothing to
    listen to. Signed out there is nowhere to record a position, so it is left off. %>
<%# Three parts, and the split is the point.

    The screen itself is what goes fullscreen and what carries the fullscreen controller,
    so it must be the one thing a move between entries never replaces -- fullscreen is
    granted to an element, and replacing that element gives it up.

    The frame stack holds the player. It is separate from the chrome so that moving to
    another entry can leave a frame alone, or swap between frames, without touching
    anything else.

    The chrome is everything that describes *this* entry: the title, the ring, the source
    switcher, the modals. All of it is replaced together on a move, which is why the
    per-entry controller lives on it -- being replaced is what makes Stimulus reconnect it
    with the new entry's values. %>
<div class="cinema__screen"
     data-controller="cinema-fullscreen cinema-navigation"
     data-action="auto-advance:move@document->cinema-navigation#moveFromEvent"
     data-cinema-fullscreen-idle-class="cinema__screen--idle"
     data-cinema-navigation-moving-class="cinema__screen--moving">

  <div id="cinema-frames" class="cinema__frames">
  <%# No `allowfullscreen`, deliberately. Fullscreen belongs to the container above, which
      keeps the controls and the up-next card on screen; the player taking it instead would
      hand the whole display to a third party. Withholding the permission is what makes
      that stick -- its button, its `f` and its double-click all go dead together, and
      fullscreen cannot be taken back off the frame once granted. See
      cinema_fullscreen_controller.js. %>
  <iframe id="cinema"
      title="<%= @entry.name %>"
      referrerpolicy="origin"
      width="100%"
      height="100%"
      allow="autoplay"
      src="<%= @embed_url %>">

  </iframe>
  </div>

  <%# Sits with the screen rather than the chrome: it is the same button whatever is
      playing, and it drives the controller on the screen itself. %>
  <button type="button" class="cinema__fullscreen" title="Fullscreen"
          data-action="click->cinema-fullscreen#toggle">
    <i class="fa-solid fa-expand"></i>
  </button>

  <div id="cinema-chrome"
       data-list-auto-next="<%= @channel.auto_next_for(current_user) %>"
       data-list-ordered="<%= @channel.ordered? %>"
       <% if user_signed_in? %>
         data-controller="player-progress"
         <%# There is no unload on a move between entries, so the position has to be taken
             on the way past instead. %>
         data-action="cinema-navigation:leaving@document->player-progress#saveNow"
         data-player-progress-url-value="<%= progress_entry_path(@entry) %>"
         data-player-progress-adapter-value="<%= @entry.resolved_source&.sync_adapter %>"
         data-player-progress-frame-value="cinema"
         data-player-progress-token-value="<%= form_authenticity_token %>"
         <%# The runtime and the fraction the client needs to spot the credits starting.
             Both are what the server itself decides completion by, so neither side can
             drift from the other. 0 means the catalogue has no runtime and the player's
             own reported duration stands in. %>
         data-player-progress-runtime-value="<%= @entry.length.to_i * 60 %>"
         data-player-progress-fraction-value="<%= UserEntry::COMPLETION_FRACTION %>"
       <% end %>>
  <%= render 'entries/source_switcher' %>

  <%# The room. It sits on the frame rather than in a sidebar because everything it does --
      following the host, correcting drift -- is about the player right underneath it. %>
  <% if user_signed_in? %>
    <% if @watch_party %>
      <%= render 'watch_parties/bar', party: @watch_party,
                                      adapter: @entry.resolved_source&.sync_adapter %>
    <% else %>
      <%= render 'watch_parties/start_button', entry: @entry, channel: @channel,
                                               subentry: @current_subentry %>
    <% end %>
  <% end %>


  <div class="cinema__title">
    <h3 class="d-flex align-items-center list-name-container" onmouseover="this.querySelector('.subscription-icon').style.opacity='1'" onmouseout="this.querySelector('.subscription-icon').style.opacity='0'">
      <%= link_to @channel.name, list_path(@channel), class: 'text-white text-decoration-none me-2' %>
      <%# Signed out under an open access mode: there is no account to subscribe with, so
          the whole control is left out rather than shown and refused. %>
      <% if user_signed_in? && current_user.subscribed_to?(@channel) %>
        <%= button_to list_unsubscribe_path(@channel, redirect_to_sibling: true),
            method: :patch,
            class: "border-0 bg-transparent p-0 subscription-icon text-white",
            style: "opacity: 0; transition: opacity 0.2s; cursor: pointer; font-size: 0.8em;",
            data: { turbo_confirm: "Unsubscribe from #{@channel.name}?" },
            form: { style: "display: inline;" } do %>
          <i class="fa-solid fa-xmark"></i>
        <% end %>
      <% elsif user_signed_in? %>
        <%= button_to list_subscribe_path(@channel),
            method: :patch,
            class: "border-0 bg-transparent p-0 subscription-icon text-white",
            style: "opacity: 0; transition: opacity 0.2s; cursor: pointer; font-size: 0.8em;",
            form: { style: "display: inline;" } do %>
          <i class="fa-solid fa-plus" title="Subscribe to channel"></i>
        <% end %>
      <% end %>
    </h3>
    <h1><%= @entry.name %></h1>
    <% if @entry.media == "series" && @current_subentry %>
      <h3><%= @entry.series %></h3>
      <h3>S<%= @current_subentry.season %>E<%= @current_subentry.episode %> - <%= @current_subentry.name %></h3>
    <% elsif @entry.media == "anime" && @current_subentry %>
      <h3>E<%= @current_subentry.calculate_absolute_episode_number %> - <%= @current_subentry.name %></h3>
    <% elsif @entry.media == "episode" %>
      <h3><%= @entry.series %> - S<%= @entry.season %>E<%= @entry.episode %></h3>
    <% end %>

    <% if @entry.completed_by?(current_user) %>
      <% user_review = current_user&.review_for(@entry) %>
      <% if user_review %>
        <div class="mt-2">
          <small class="text-info">
            <i class="fa-solid fa-star text-warning"></i>
            Your rating: <%= user_review %>/10
          </small>
        </div>
      <% end %>
    <% end %>
  </div>
  <div id="watchCinemaControls" class="d-flex justify-content-center cinema__control" style="right: 390px; top: 100px; left: auto;">
    <div class="position-relative" style="width: 80px; height: 80px;">
      <%= link_to list_watch_current_path(@channel.find_sibling(:previous) || @channel),
                  data: { cinema_move: true } do %>
        <i class="fa-solid fa-3x fa-caret-up position-absolute top-0 start-50 translate-middle-x"></i>
      <% end %>
      <%# Everything in the ring except the channel arrows and the way home writes
          something -- a position, a completion, an edit -- so a signed-out visitor gets
          the ring without them rather than buttons that bounce off the sign-in page. %>
      <% if user_signed_in? %>
        <%= button_to increment_current_entry_path(@entry, mode: 'watch', channel: @channel.id), method: :patch,
              class: 'p-0 border-0 bg-transparent text-decoration-none',
              form: { class: 'd-inline', data: { cinema_move: true } } do %>
          <i class="fa-solid fa-3x fa-caret-right position-absolute top-50 end-0 translate-middle-y"></i>
        <% end %>
        <%= button_to shuffle_current_entry_path(@entry, mode: 'watch', channel: @channel.id), method: :patch,
              class: 'p-0 border-0 bg-transparent text-decoration-none',
              form: { class: 'd-inline', data: { cinema_move: true } } do %>
          <i class="fa-solid fa-2x fa-shuffle position-absolute top-0 end-0 translate-middle-y" title="Shuffle channel"></i>
        <% end %>
        <i class="fa-solid fa-pen fa-2x position-absolute bottom-0 end-0 translate-middle-y cinema__edit" data-bs-toggle="modal" data-bs-target="#editModal" data-id="<%= @entry.id %>" data-action="click->edit#toggle"></i>
        <%# Opposite the pen, in the ring's one free corner. Films only -- Letterboxd
            catalogues nothing else -- and only for someone who has linked an account,
            since to anyone else it is a prompt to review somewhere they do not post. %>
        <% if current_user.letterboxd_enabled? && letterboxd_reviewable?(@entry) %>
          <div class="position-absolute bottom-0 start-0 translate-middle-y cinema__letterboxd">
            <%= render 'shared/letterboxd_button', url: letterboxd_review_path(@entry),
                                                   name: @entry.name,
                                                   icon: 'fa-letterboxd fa-2x' %>
          </div>
        <% end %>
        <div class="position-absolute top-0 start-0 translate-middle-y">
          <%= render 'entries/completion_status', entry: @entry, user: current_user %>
        </div>
      <% end %>
      <%= link_to list_watch_current_path(@channel.find_sibling(:next) || @channel),
                  data: { cinema_move: true } do %>
        <i class="fa-solid fa-3x fa-caret-down position-absolute bottom-0 start-50 translate-middle-x"></i>
      <% end %>
      <% if user_signed_in? %>
        <%= button_to decrement_current_entry_path(@entry, mode: 'watch', channel: @channel.id), method: :patch,
              class: 'p-0 border-0 bg-transparent text-decoration-none',
              form: { class: 'd-inline', data: { cinema_move: true } } do %>
          <i class="fa-solid fa-3x fa-caret-left position-absolute top-50 start-0 translate-middle-y"></i>
        <% end %>
      <% end %>
      <%= link_to root_path, class: 'text-decoration-none' do %>
        <i class="fa-solid fa-house fa-2x position-absolute top-50 start-50 translate-middle"></i>
      <% end %>
    </div>
  </div>
  <!-- Review Modal -->
  <%= render 'entries/review_modal' %>

  <!-- Edit Modal -->
  <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog" data-edit-target="modal">
      <div class="modal-content">
      <div class="modal-header">
    <h5 class="modal-title" id="editModal<%= @entry.id %>Label">Modal title</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <div class="modal-body">
    <%= simple_form_for(@entry, html: { data: { turbo: false } }) do |f| %>
      <%= f.input :name %>
      <%= f.input :source_url, label: "Source URL", hint: "Google Drive, mega, YouTube or archive.org link — or any direct URL. Leave blank for entries that play from an IMDb id." %>
      <%= f.association :provider,
            collection: Source.active.order(:position),
            label_method: ->(s) { "#{s.name} (#{s.kind})" },
            include_blank: "— Inherit channel default —",
            label: "Source provider" %>
      <%= f.input :source_key, label: "Source key / URL",
            hint: "Direct providers only (Drive id, mega key#fragment, YouTube id, or full URL)." %>
      <%= f.input :plot %>
      <% if @entry.media == 'episode' %>
        <%= f.input :season %>
        <%= f.input :episode %>
      <% end %>

      <!-- Show final rendered URL for debugging -->
      <div class="mb-3">
        <label class="form-label text-muted">Current URL</label>
        <div class="p-2 border rounded" style="font-family: monospace; font-size: 0.85rem; word-break: break-all;">
          <%= @entry.embed_url(subentry: @current_subentry, autoplay: @channel.auto_play_for(current_user)) || "No source available" %>
        </div>
        <small class="form-text text-muted d-block">
          Provider: <%= @entry.resolved_source&.name || "none" %>
          <% if @entry.source_key.present? %> &middot; key: <%= @entry.source_key %><% end %>
        </small>
        <% if @entry.media == 'series' || @entry.media == 'anime' %>
          <small class="form-text text-muted">
            Current Episode:
            <% if @current_subentry %>
              <% if @entry.media == 'anime' %>
                Episode <%= @current_subentry.calculate_absolute_episode_number %> - <%= @current_subentry.name %>
              <% else %>
                S<%= @current_subentry.season %>E<%= @current_subentry.episode %> - <%= @current_subentry.name %>
              <% end %>
              <br>
              <%# Computed from the provider's template; subentries stopped storing one. %>
              Subentry Source: <%= @entry.embed_url(subentry: @current_subentry) %>
              <% if @entry.media == 'anime' %>
                <br>
                Absolute Episode: <%= @current_subentry.calculate_absolute_episode_number %>
              <% end %>
            <% else %>
              None set
            <% end %>
          </small>
        <% end %>
      </div>

      <%= f.button :submit %>
    <% end %>
    </div>
    </div>
  </div>
</div>


<%# What happens when a film ends and nobody says otherwise. Only where the channel asks
    for it -- Auto Next is the channel's own setting and this is the feature it names --
    and only for somebody signed in, since advancing writes their position.

    Inside the cinema screen, because that is the element that goes fullscreen: anything
    outside it is not rendered at all while fullscreen, and a countdown nobody can see
    would advance the channel unannounced. %>
<% if user_signed_in? && @channel.auto_next_for(current_user) %>
  <%= render 'entries/auto_advance_modal', entry: @entry, channel: @channel %>
<% end %>
  </div>
</div>
