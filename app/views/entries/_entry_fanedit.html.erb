<%= turbo_frame_tag dom_id(entry) do %>
  <div class="card-container">
    <%# if entry.note %>
    <%# end %>
    <div class="grid-card" id="<%= entry.id %>">
      <div class="card-picture">
        <%= link_to watch_path_for(entry, viewing: @viewing), data: { turbo: false } do %>
          <%= entry_poster_image_tag(entry) %>
          <span class="fa-stack fa-4x play-button">
            <i class="fa-solid fa-circle fa-stack-2x icon-background"></i>
            <i class="fa-solid fa-play fa-stack-1x icon-foreground"></i>
          </span>
        <% end %>
      </div>
      <div class="card-stuff">
        <div class="card-title">
          <%= entry_source_badge(entry, viewing: @viewing) %>
          <h5 class="card-header"><bold><%= entry.name %></bold></h5>
        </div>
        <div class="card-details" data-controller="card-panes">
          <%# Not the year and the rating a film's card carries. The year belongs to the
              source film and the rating to a cut nobody catalogues -- on a fanedit it is
              blank, or the original's, carried over by the duplicate it was made from.
              What it was cut from and who cut it is what this card is for. %>
          <% origin = fanedit_origin(entry) %>
          <% if origin %>
            <p class="fanedit-origin"><%= origin %></p>
          <% end %>
          <% credit = fanedit_credit(entry) %>
          <% if credit %>
            <p class="fanedit-credit"><%= credit %></p>
          <% end %>
          <%# Genre and runtime share a row the way the year and the rating used to. The
              runtime is the one number on a fanedit that is about the cut rather than the
              film it came from -- and it is what the cable schedule lays the slot out by,
              so a blank one here is the thing to go and fill in. %>
          <div class="d-flex justify-content-between">
            <p class="mb-4"><small><%= entry.genre %></small></p>
            <% if entry.length.present? %>
              <p class="mb-4"><small><%= entry.length %> min</small></p>
            <% end %>
          </div>
          <%# The box the synopsis lives in, and the one the tab strip and the scroll
              caret are positioned against. Here rather than wrapped around the plot by
              card_panes_controller.js on first hover: built there, the card was one shape
              before the pointer arrived and another after it, and every way of making the
              wrapper stand in for the plot exactly was a rule that had to be kept in step
              with the plot's own. Two tags per card is the cheaper answer. %>
          <div class="card-panes">
            <p class="card-plot"><%= entry.plot %></p>
          </div>
        </div>
        <div class="card-menu">
          <% if entry.trailer.present? %>
            <a href="#" data-bs-toggle="modal" data-bs-target="#trailerModal"
               data-trailer-url="<%= convert_to_embed_url(entry.trailer) %>"
               data-trailer-name="<%= entry.name %>">
              <i class="fa-solid fa-trailer"></i>
            </a>
          <% end %>
          <%= render 'entries/completion_status', entry: entry, user: current_user %>
          <% if current_user&.can_edit_entry?(entry) %>
            <%= render 'shared/poster_selector_button', entry: entry %>
            <i class="fa-solid fa-pen" data-bs-toggle="modal" data-bs-target="#editModal" data-id="<%= entry.id %>" data-action="click->edit#toggle"></i>
            <%# <%= link_to edit_entry_path(entry) do %>
              <%# <i class="fa-solid fa-pen"></i> %>
              <%# <% end %>
              <%= link_to entry_path(entry),
                  data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} do %>
                <i class="fa-solid fa-trash"></i>
              <% end %>
            <% end %>
            <i class="fa-solid fa-link-slash <%= entry.stream ? 'link-ok' : 'link-broken' %>"
        title="Report broken link"
        data-controller="link"
        data-link-id-value="<%= entry.id %>"
        data-action="click->link#toggle"></i>
            <%= duplicate_entry_link(entry) %>
          </div>
        </div>
      </div>
      <% if entry.trailer.present? %>
      <% end %>

    </div>
<% end %>
