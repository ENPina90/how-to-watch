<div class="row entry-minimal border border-dark border-top-0 border-start-0 border-end-0" data-id="<%= entry.id %>">
  <div class="col-1 align-self-center d-flex align-items-center gap-2">
    <%# Outside .entry-minimal-icons, which stay hidden until hover: a ticked box has to
        stay visible, or there is no seeing what a bulk delete is about to take. %>
    <% if current_user&.can_edit_entry?(entry) %>
      <%# pointerdown starts a run: hold and drag down the page to tick everything the
          pointer crosses. A press that does not move is left alone, so a plain click still
          toggles the one box natively. %>
      <input type="checkbox" class="form-check-input mt-0" value="<%= entry.id %>"
             aria-label="Select <%= entry.name %>"
             data-bulk-select-target="checkbox"
             data-action="change->bulk-select#refresh pointerdown->bulk-select#startPaint">
    <% end %>
    <i class="fa-solid fa-grip-vertical entry-minimal-icons"></i>
  </div>
  <div class="col-8 mt-2">
    <%# In a span of its own so the sort controller can renumber the rows after a drop. %>
    <span class="entry-minimal__index"><%= index %></span>. <%= link_to entry.name, (defined?(@is_mobile) && @is_mobile) ? entry_path(entry) : watch_entry_path(entry), data: { turbo: false } %>
    <% if entry.media == "episode" %>
      <div class="d-flex justify-content-between">
        <p><small><%= entry.series %> - S<%= entry.season %>E<%= entry.episode %></small></p>
      </div>
    <% else %>
      <p><small><%= entry.year %></small></p>
    <% end %>
  </div>

  <div class="col-3 d-flex justify-content-between align-items-center entry-minimal-icons">
    <%= render 'entries/completion_status', entry: entry, user: current_user, minimal: true %>
    <% if current_user&.can_edit_entry?(entry) %>
      <i class="fa-solid fa-pen" data-bs-toggle="modal" data-bs-target="#editModal" data-id="<%= entry.id %>" data-action="click->edit#toggle"></i>
      <%= link_to entry_path(entry),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } do %>
        <i class="fa-solid fa-trash text-black"></i>
      <% end %>
    <% end %>
    <i class="fa-solid fa-link-slash <%= entry.stream == false ? 'link-broken' : 'link-ok' %>"
        title="Report broken link"
        data-controller="link"
        data-link-id-value="<%= entry.id %>"
        data-action="click->link#toggle"></i>
    <%= duplicate_entry_link(entry, icon_class: 'text-black') %>
  </div>
</div>
