<div class="profile-page">
  <header class="profile-header">
    <h1><%= @user.display_name %></h1>
    <p class="profile-header__email"><%= @user.email %></p>
  </header>

  <section class="profile-stats">
    <div class="profile-stat">
      <span class="profile-stat__value"><%= @lists_count %></span>
      <span class="profile-stat__label"><%= 'channel'.pluralize(@lists_count) %></span>
    </div>
    <div class="profile-stat">
      <span class="profile-stat__value"><%= @entries_count %></span>
      <span class="profile-stat__label"><%= 'entry'.pluralize(@entries_count) %></span>
    </div>
    <div class="profile-stat">
      <span class="profile-stat__value"><%= @unwatched_count %></span>
      <span class="profile-stat__label">still to watch</span>
    </div>
  </section>

  <section class="profile-section">
    <h2>Profile</h2>

    <%= simple_form_for @user, url: profile_path, method: :patch do |f| %>
      <%= f.error_notification %>
      <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

      <%= render 'shared/letterboxd_field', f: f %>

      <%# Three states, not two: blank leaves each channel to its own setting, which is
          what everybody had before this existed. Answering here overrides every channel
          at once, which is the reason to answer here rather than editing each of them. %>
      <%= f.input :auto_play, as: :select,
            collection: [['Always', true], ['Never', false]],
            include_blank: 'Follow each channel',
            label: 'Auto play',
            hint: 'Start playing as soon as an entry opens.' %>
      <%= f.input :auto_next, as: :select,
            collection: [['Always', true], ['Never', false]],
            include_blank: 'Follow each channel',
            label: 'Auto next',
            hint: 'Offer the next entry when one finishes.' %>

      <div class="form-actions">
        <%= f.button :submit, 'Save', class: 'btn btn-primary' %>
      </div>
    <% end %>

    <%# The channel is built by a background job, so the page has to say where that got
        to -- a channel that has simply not appeared is otherwise indistinguishable from
        one that failed. %>
    <% if @user.letterboxd_enabled? %>
      <div class="letterboxd-sync letterboxd-sync--<%= @user.letterboxd_sync_state %>">
        <% case @user.letterboxd_sync_state %>
        <% when :waiting %>
          <p>
            <i class="fa-solid fa-circle-notch fa-spin"></i>
            Reading your Letterboxd diary. This takes a minute for a long diary — reload
            the page. If it stays like this, the background queue is not running.
          </p>
        <% when :failed %>
          <p>
            <i class="fa-solid fa-triangle-exclamation"></i>
            Could not read your diary: <%= @user.letterboxd_sync_error %>
          </p>
          <p class="profile-note">
            Check the username is your Letterboxd handle and that your profile is public.
          </p>
        <% when :ok %>
          <% channel = @user.letterboxd_list %>
          <p>
            <i class="fa-brands fa-square-letterboxd"></i>
            <% if channel %>
              Your diary is in <%= link_to channel.name, list_path(channel) %>
              (<%= pluralize(channel.entries.count, 'film') %>),
            <% end %>
            updated <%= time_ago_in_words(@user.letterboxd_synced_at) %> ago. It refreshes
            weekly, and shortly after you review something on Letterboxd.
          </p>
        <% end %>

        <%= button_to 'Sync now', letterboxd_sync_path, class: 'btn btn-sm btn-outline-secondary' %>
      </div>
    <% end %>
  </section>

  <section class="profile-section">
    <h2>Email and password</h2>
    <p class="profile-note">Changing either needs your current password.</p>

    <%= simple_form_for @user, as: :user, url: registration_path(:user), html: { method: :put } do |f| %>
      <%= f.input :email, required: true %>
      <%= f.input :password,
                  required: false,
                  hint: "Leave blank to keep your current password.",
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation,
                  required: false,
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :current_password,
                  required: true,
                  hint: "We need this to confirm the change.",
                  input_html: { autocomplete: "current-password" } %>

      <div class="form-actions">
        <%= f.button :submit, 'Update', class: 'btn btn-primary' %>
      </div>
    <% end %>
  </section>

  <section class="profile-section profile-section--danger">
    <h2>Cancel my account</h2>
    <p class="profile-note">This deletes your channels and everything in them.</p>
    <%= button_to 'Delete my account',
                  registration_path(:user),
                  method: :delete,
                  class: 'btn btn-outline-danger',
                  data: { turbo_confirm: 'This cannot be undone. Delete your account?' } %>
  </section>
</div>
