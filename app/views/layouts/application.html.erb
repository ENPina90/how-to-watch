<!DOCTYPE html>
<html>
  <head>
    <title>HowToWatch</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# TMDB key for the client-side search controllers. Browser-side keys are public by nature; keep it in one place. %>
    <meta name="tmdb-key" content="<%= ENV["TMDB_API_KEY"] %>">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <%# `page-<controller>-<action>` alongside the sidebar and theme classes already here,
      so a style can be scoped to one page without a flag being threaded through to it. %>
  <body class="page-<%= controller_name.dasherize %>-<%= action_name.dasherize %> <%= @sidebar_collapsed ? 'sidebar-collapsed' : '' %> <%= user_signed_in? && !@hide_sidebar ? 'has-sidebar' : '' %> <%= user_signed_in? && current_user.dark_mode ? 'dark-mode' : 'light-mode' %>">
    <%= render "shared/navbar" %>
    <%= render "shared/impersonation_banner" %>
    <%= render 'shared/flashes' %>
    <% if user_signed_in? && !@hide_sidebar %>
      <%= render "shared/sidebar" %>
    <% end %>
    <div class="page-container" id="pageContainer" style="<%= 'margin-left: 280px; width: calc(100% - 280px);' if user_signed_in? && !@hide_sidebar && !@sidebar_collapsed %>">
      <div class="content-container"><%= yield %></div>
      <div class="footer-container"><%= render "shared/footer" %></div>
    </div>

    <!-- Global Search Templates -->
    <template id="listSearchMovieTemplate">
      {{#movies}}
      <div class="card mb-3">
        <div class="row g-0">
          <div class="col-md-3">
            <img src="{{Poster}}" class="img-fluid rounded-start h-100" alt="{{Title}} poster" style="object-fit: cover;">
          </div>
          <div class="col-md-9">
            <div class="card-body">
              <h6 class="card-title">{{Title}}</h6>
              <p class="card-text">
                <small class="text-muted">{{Year}}{{#Rating}} • {{.}}/10{{/Rating}}</small><br>
                <small class="text-muted">{{Genre}}</small>
              </p>
              <p class="card-text">{{Plot}}</p>
              <div class="d-flex gap-2">
                <a href="/watch_now?imdb={{imdbID}}&title={{Title}}&type=movie&poster={{Poster}}"
                   class="btn btn-success btn-sm">
                  <i class="fa-solid fa-play me-1"></i>Watch Now
                </a>
                {{#entryId}}
                <%# Already on this channel: the same button takes it back out, the way the
                    /entries/new results do. %>
                <button type="button"
                        class="btn btn-danger btn-sm"
                        data-action="click->list-search#remove"
                        data-entry-id="{{entryId}}">
                  <i class="fa-solid fa-trash me-1"></i>Remove
                </button>
                {{/entryId}}
                {{^entryId}}
                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-action="click->list-search#add"
                        data-imdb-id="{{imdbID}}"
                        data-tmdb-id="{{tmdbID}}"
                        data-title="{{Title}}"
                        data-poster="{{Poster}}">
                  <i class="fas fa-plus me-1"></i>{{addLabel}}
                </button>
                {{/entryId}}
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/movies}}
    </template>

    <template id="listSearchShowTemplate">
      {{#movies}}
      <div class="card mb-3">
        <div class="row g-0">
          <div class="col-md-3">
            <img src="{{Poster}}" class="img-fluid rounded-start h-100" alt="{{Title}} poster" style="object-fit: cover;">
          </div>
          <div class="col-md-9">
            <div class="card-body">
              <h6 class="card-title">{{Title}}</h6>
              <p class="card-text">
                <small class="text-muted">{{Year}}{{#Rating}} • {{.}}/10{{/Rating}}</small><br>
                <small class="text-muted">{{totalSeasons}} seasons</small>
              </p>
              <p class="card-text">{{Plot}}</p>
              <div class="d-flex gap-2">
                <a href="/watch_now?imdb={{imdbID}}&title={{Title}}&type=tv&poster={{Poster}}&tmdb={{tmdbID}}"
                   class="btn btn-success btn-sm">
                  <i class="fa-solid fa-play me-1"></i>Watch Now
                </a>
                {{#entryId}}
                <%# Already on this channel: the same button takes it back out, the way the
                    /entries/new results do. %>
                <button type="button"
                        class="btn btn-danger btn-sm"
                        data-action="click->list-search#remove"
                        data-entry-id="{{entryId}}">
                  <i class="fa-solid fa-trash me-1"></i>Remove
                </button>
                {{/entryId}}
                {{^entryId}}
                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-action="click->list-search#add"
                        data-imdb-id="{{imdbID}}"
                        data-tmdb-id="{{tmdbID}}"
                        data-title="{{Title}}"
                        data-poster="{{Poster}}"
                        data-type="{{#anime}}anime{{/anime}}">
                  <i class="fas fa-plus me-1"></i>{{addLabel}}
                </button>
                {{/entryId}}
                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        data-action="click->list-search#seeEpisodes"
                        data-imdb-id="{{imdbID}}"
                        data-tmdb-id="{{tmdbID}}"
                        data-title="{{Title}}"
                        data-poster="{{Poster}}"
                        data-seasons="{{totalSeasons}}">
                  <i class="fa-solid fa-list-ol me-1"></i>See Episodes
                </button>
                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        data-action="click->list-search#topEpisodes"
                        data-imdb-id="{{imdbID}}"
                        data-tmdb-id="{{tmdbID}}"
                        data-title="{{Title}}"
                        data-poster="{{Poster}}"
                        data-seasons="{{totalSeasons}}">
                  <i class="fa-solid fa-star me-1"></i>Top Rated Episodes
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/movies}}
    </template>

    <%# One season of a show, reached from a result's See Episodes. Same card shape as the
        results it replaces, and the same + buttons: whichever channel the search was made
        from takes them, or the picker asks. %>
    <template id="listSearchEpisodeTemplate">
      <div class="d-flex align-items-center gap-2 flex-wrap p-3 border-bottom bg-light">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="click->list-search#backToResults">
          <i class="fa-solid fa-arrow-left me-1"></i>Results
        </button>
        <strong class="me-auto">{{series.title}}{{#top}} — top rated{{/top}}</strong>

        {{^top}}
        <button type="button"
                class="btn btn-outline-primary btn-sm"
                data-action="click->list-search#topEpisodes"
                data-imdb-id="{{series.imdbID}}"
                data-tmdb-id="{{series.tmdbID}}"
                data-title="{{series.title}}"
                data-poster="{{series.poster}}"
                data-seasons="{{seasonCount}}">
          <i class="fa-solid fa-star me-1"></i>Top Rated Episodes
        </button>
        <%# Which season is current is set on the element after rendering, not marked up
            here: a mustache section in attribute-name position does not survive the parse.
            The browser reads <template> content as HTML before mustache ever sees it, and
            an unquoted `/` there is taken for a self-closing marker and dropped -- which
            turns {{/selected}} into an unclosed section. %>
        <select class="form-select form-select-sm w-auto season-picker"
                data-action="change->list-search#changeSeason">
          {{#seasons}}
          <option value="{{number}}">Season {{number}}</option>
          {{/seasons}}
        </select>
        <button type="button"
                class="btn btn-primary btn-sm"
                data-action="click->list-search#add"
                data-kind="season"
                data-imdb-id="{{series.imdbID}}"
                data-series-imdb-id="{{series.seriesImdbID}}"
                data-tmdb-id="{{series.tmdbID}}"
                data-title="{{series.title}}"
                data-poster="{{series.poster}}"
                data-season="{{season}}"
                data-type="{{type}}">
          <i class="fas fa-plus me-1"></i>Season
        </button>
        {{/top}}

        {{#top}}
        <%# The same slot the season controls occupy: back to them, and the bulk add. %>
        <button type="button" class="btn btn-outline-primary btn-sm" data-action="click->list-search#bySeason">
          <i class="fa-solid fa-list-ol me-1"></i>By Season
        </button>
        <button type="button" class="btn btn-primary btn-sm" data-action="click->list-search#openTopModal">
          <i class="fas fa-plus me-1"></i>Top Episodes
        </button>
        {{/top}}
      </div>

      {{#episodes}}
      <div class="card mb-3">
        <div class="row g-0">
          <div class="col-md-3">
            <img src="{{Poster}}" class="img-fluid rounded-start h-100" alt="{{Title}} still" style="object-fit: cover;">
          </div>
          <div class="col-md-9">
            <div class="card-body">
              <h6 class="card-title">{{Title}}</h6>
              <p class="card-text">
                <small class="text-muted">S{{Season}}E{{Episode}}{{#Rating}} • {{.}}/10{{/Rating}}</small>
              </p>
              {{#Plot}}<p class="card-text">{{Plot}}</p>{{/Plot}}
              <div class="d-flex gap-2">
                <a href="/watch_now?imdb={{seriesImdbID}}&title={{Title}}&type=tv&tmdb={{tmdbID}}&season={{Season}}&episode={{Episode}}&poster={{Poster}}"
                   class="btn btn-success btn-sm">
                  <i class="fa-solid fa-play me-1"></i>Watch Now
                </a>
                {{#entryId}}
                <%# Already on this channel: the same button takes it back out, the way the
                    /entries/new results do. %>
                <button type="button"
                        class="btn btn-danger btn-sm"
                        data-action="click->list-search#remove"
                        data-entry-id="{{entryId}}">
                  <i class="fa-solid fa-trash me-1"></i>Remove
                </button>
                {{/entryId}}
                {{^entryId}}
                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-action="click->list-search#add"
                        data-imdb-id="{{seriesImdbID}}"
                        data-series-imdb-id="{{seriesImdbID}}"
                        data-tmdb-id="{{tmdbID}}"
                        data-title="{{Title}}"
                        data-poster="{{Poster}}"
                        data-season="{{Season}}"
                        data-episode="{{Episode}}">
                  <i class="fas fa-plus me-1"></i>Episode
                </button>
                {{/entryId}}
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/episodes}}
    </template>

    <template id="listSearchListTemplate">
      {{#lists}}
      <div class="card mb-3">
        <div class="row g-0">
          <div class="col-md-3">
            {{#posterUrl}}
            <img src="{{posterUrl}}" class="img-fluid rounded-start h-100" alt="{{name}} poster" style="object-fit: cover;">
            {{/posterUrl}}
            {{^posterUrl}}
            <div class="bg-secondary h-100 d-flex align-items-center justify-content-center">
              <i class="fa-solid fa-list fa-3x text-muted"></i>
            </div>
            {{/posterUrl}}
          </div>
          <div class="col-md-9">
            <div class="card-body">
              <h6 class="card-title">{{name}}</h6>
              <p class="card-text">
                <small class="text-muted">by {{creator}} • {{entryCount}} entries</small><br>
                {{#isPrivate}}
                <small class="badge bg-secondary">Private</small>
                {{/isPrivate}}
                {{^isPrivate}}
                <small class="badge bg-success">Public</small>
                {{/isPrivate}}
              </p>
              {{#description}}
              <p class="card-text"><small>{{description}}</small></p>
              {{/description}}
              <div class="d-flex gap-2">
                <a href="/lists/{{id}}" class="btn btn-primary btn-sm">
                  <i class="fa-solid fa-eye me-1"></i>View Channel
                </a>
                <%# Files this channel inside another one, the same way the + on an entry
                    files it: into the channel you are looking at, or into whichever one
                    the picker is answered with. %>
                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        data-action="click->list-search#add"
                        data-kind="channel"
                        data-list-id="{{id}}"
                        data-title="{{name}}">
                  <i class="fas fa-plus me-1"></i>Add to Channel
                </button>
                {{#canSubscribe}}
                <form action="/lists/{{id}}/subscribe" method="post" style="display: inline;">
                  <input type="hidden" name="_method" value="patch">
                  <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-bookmark me-1"></i>Subscribe
                  </button>
                </form>
                {{/canSubscribe}}
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/lists}}
    </template>

    <%# The Top Entries prompt from /entries/new, for the overlay's top-rated view. Its
        buttons are wired when it opens rather than by data-action: it sits at the end of
        the body, outside the element the search controller is mounted on. %>
    <div class="modal fade" id="topEpisodesModal" tabindex="-1" aria-labelledby="topEpisodesModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="topEpisodesModalLabel">
              Add Top <span class="fw-bold text-nowrap" id="topEpisodesCount">10</span> Episodes
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <label for="topEpisodesSlider" class="form-label">Select number of episodes to add:</label>
            <input type="range" class="form-range" min="1" max="20" value="10" id="topEpisodesSlider">
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="topEpisodesConfirm">Add Episodes</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Global Channel Selection Modal -->
    <div class="modal fade" id="listSelectionModal" tabindex="-1" aria-labelledby="listSelectionModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="listSelectionModalLabel">Add to Channel</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="row mb-3">
              <div class="col-4">
                <img id="modalMoviePoster" src="" alt="" class="img-fluid rounded">
              </div>
              <div class="col-8">
                <h6>Select a list to add this item to:</h6>
                <div id="listSelectionContainer">
                  <!-- Channel options will be populated by JavaScript -->
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>

  </body>
</html>
