<!DOCTYPE html>
<html>
  <head>
    <title>HowToWatch</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="turbo-cache-control" content="no-cache">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <%# Same tab icon as the application layout -- see the note there. %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# TMDB key for the client-side search controllers. Browser-side keys are public by nature; keep it in one place. %>
    <meta name="tmdb-key" content="<%= ENV["TMDB_API_KEY"] %>">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Pages that frame a third-party player warm its connections from here. %>
    <%= yield :head %>
  </head>

  <body class="cinema__mode <%= @sidebar_collapsed ? 'sidebar-collapsed' : '' %> <%= user_signed_in? && !@hide_sidebar ? 'has-sidebar' : '' %> <%= @cable ? 'cable__mode entries-sidebar-collapsed' : 'has-entries-sidebar' %> <%= theme_class %>" data-turbo="false">
    <%= render "shared/impersonation_banner" %>
    <%= render 'shared/flashes' %>

    <% if user_signed_in? && !@hide_sidebar %>
      <%= render "shared/sidebar" %>
    <% end %>

    <div class="page-container" id="pageContainer" style="margin: 0; width: 100%;">
      <%= yield %>
    </div>
  </body>
</html>
