<!DOCTYPE html>
<html>
  <head>
    <title>How To Watch</title>
    <%# `viewport-fit=cover` so the bar can reach the top edge on a notched phone; the
        safe-area padding on .m-bar is what keeps its contents out from under the notch. %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="tmdb-key" content="<%= ENV["TMDB_API_KEY"] %>">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="m-body">
    <%# One bar on every page: the way home, the field, and the menu. What the field does
        depends on the page -- on the home page it filters the channels already on screen,
        and on a channel it searches everything and offers to add what it finds. Both are
        one controller, told which it is. %>
    <div data-controller="mobile-shell"
         data-mobile-shell-mode-value="<%= @mobile_search_mode || 'filter' %>"
         data-mobile-shell-list-id-value="<%= @list&.id %>">

      <div class="m-bar">
        <%= link_to root_path, class: "m-bar__home", "aria-label": "Channels" do %>
          <i class="fa-solid fa-house"></i>
        <% end %>

        <%# Hidden where the field has no job: the listings page has nothing to filter and
            nothing to add to, and a search box that does nothing is worse than no box. %>
        <div class="m-bar__search" <%= 'hidden' if @mobile_search_mode == 'none' %>>
          <input type="search"
                 class="m-bar__input"
                 autocomplete="off"
                 enterkeyhint="search"
                 placeholder="<%= @mobile_search_placeholder || 'Filter your channels' %>"
                 aria-label="<%= @mobile_search_placeholder || 'Filter your channels' %>"
                 data-mobile-shell-target="input"
                 data-action="input->mobile-shell#typed">
        </div>

        <button type="button" class="m-bar__menu-button" aria-label="Menu"
                data-action="click->mobile-shell#toggleMenu">
          <i class="fa-solid fa-bars"></i>
        </button>

        <div class="m-menu" data-mobile-shell-target="menu" hidden>
          <%# The listings are the one part of cable the phone view keeps: reading what is
              on is not watching it. %>
          <%= link_to cable_listings_path, class: "m-menu__item" do %>
            <i class="fa-solid fa-table-list"></i> TV Guide
          <% end %>

          <%# The way out. The phone view plays nothing, so somebody who does mean to watch
              on their phone needs to be able to say so rather than go and find a laptop. %>
          <%= button_to view_mode_path, params: { mode: 'desktop' },
                        class: "m-menu__item", form_class: "d-contents" do %>
            <i class="fa-solid fa-display"></i> Full site
          <% end %>

          <% if user_signed_in? %>
            <%= button_to destroy_user_session_path, method: :delete,
                          class: "m-menu__item", form_class: "d-contents" do %>
              <i class="fa-solid fa-right-from-bracket"></i> Log out
            <% end %>
          <% else %>
            <%= link_to new_user_session_path, class: "m-menu__item" do %>
              <i class="fa-solid fa-right-to-bracket"></i> Log in
            <% end %>
          <% end %>
        </div>
      </div>

      <%# Where a search puts its results. Empty until there is something to show, and it
          covers the page rather than hanging off the field: there is no room on a phone
          for a listing and its results at once. %>
      <div class="m-overlay" data-mobile-shell-target="overlay" hidden>
        <div class="m-overlay__types">
          <button type="button" class="m-overlay__type m-overlay__type--on"
                  data-mobile-shell-target="movieType"
                  data-action="click->mobile-shell#searchMovies">Movies</button>
          <button type="button" class="m-overlay__type"
                  data-mobile-shell-target="showType"
                  data-action="click->mobile-shell#searchShows">Series</button>
        </div>
        <div class="m-overlay__results" data-mobile-shell-target="results"></div>
      </div>

      <%= render "shared/impersonation_banner" %>
      <%= render "shared/flashes" %>

      <%# Inside the controller, not after it: the page's own rows are targets -- the home
          page's channels are what the field filters -- and a Stimulus target is only found
          within the element the controller is on. %>
      <main class="m-page"><%= yield %></main>
    </div>

    <%# The card a search result is drawn as: the same shape as the ones on a channel, so a
        result and a thing you already have look like the same kind of object. %>
    <template id="mobileResultTemplate">
      {{#results}}
      <div class="m-card" data-mobile-shell-target="result">
        <button type="button" class="m-card__flip" data-action="click->mobile-shell#flip">
          <div class="m-card__faces">
            <div class="m-card__face">
              <img src="{{Poster}}" alt="{{Title}}" loading="lazy">
            </div>
            <div class="m-card__face m-card__face--back">
              <div class="m-card__back-title">{{Title}}</div>
              <div class="m-card__meta">{{Year}}{{#Rating}} &middot; {{.}}{{/Rating}}</div>
              <div class="m-card__meta">{{Genre}}</div>
              <div class="m-card__plot">{{Plot}}</div>
            </div>
          </div>
        </button>
        <div class="m-card__title">{{Title}}</div>
        <%# Every Mustache tag here sits in an attribute value or between elements, never
            where an attribute name goes -- the browser parses this template as HTML before
            Mustache is handed it, and a section tag in that position comes back out
            lowercased and re-quoted, which stops the whole template parsing. %>
        <button type="button" class="m-add"
                data-action="click->mobile-shell#add"
                data-imdb-id="{{imdbID}}"
                data-tmdb-id="{{tmdbID}}"
                data-type="{{addType}}">+ {{addLabel}}</button>
      </div>
      {{/results}}
    </template>
  </body>
</html>
