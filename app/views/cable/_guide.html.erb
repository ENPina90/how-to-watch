<%# The listing grid: the whole dial across a day, laid out the way cable guides were.

    Programmes are placed by time rather than flowed, because that is what the grid means --
    a wide cell is a long film, and two channels' boundaries line up because they happen at
    the same moment.

    Placed in pixels rather than percentages, because the track is a day long and only a few
    hours of it are on screen: a percentage would squeeze twenty-four hours into the width
    of four and make every cell unreadable. One hour is --guide-hour-width, and everything
    on the grid -- columns, cells, the line marking now -- is a multiple of it, so the
    whole thing rescales from one number.

    Times are in the viewer's own zone. The schedule is a set of instants, the same for
    everybody; what time those instants are is a question about where you are sitting. %>
<%
  window_start = @window.begin
  # Three days, so 72 hours -- except across a daylight saving change, where one of them is
  # 23 or 25. Measured rather than assumed for that reason.
  window_hours = CableSchedule.guide_hours(@window)
  # Where a moment falls along the track, in hours from the left edge. Clamped, so a film
  # that began before the window opened starts at the edge rather than off it.
  hours = ->(time) { (((time - window_start) / 3600.0)).clamp(0, window_hours) }
  track = ->(count) { "calc(var(--guide-hour-width) * #{count.round(5)})" }
  columns = ((window_hours * 2).round).times.map { |i| window_start + (i * 30.minutes) }

  # The days the track crosses, as bands to label. Midnight to midnight in the viewer's own
  # zone, like every other time on the grid -- a viewer somewhere else is reading the same
  # schedule against their own clock, and their day is the one they want named. So the first
  # and last bands are partial for anybody outside the schedule's zone, which is fine: a
  # band is as wide as the part of that day the window holds.
  day_bands = columns.map { |column| column.in_time_zone(@zone).beginning_of_day }.uniq.map do |day|
    { day: day, from: hours.call(day), to: hours.call(day + 1.day) }
  end
%>
<%# The actions are bound here rather than per cell: this markup is fetched and inserted,
    and one delegating listener on the grid serves however many programmes come back.
    Tuning itself is not handled here at all -- the cells carry data-cinema-move, and
    cinema-navigation is on the same screen element, so it answers the click and changes
    channel in place. This only follows it. %>
<div class="tvguide__grid"
     data-action="mouseover->cable-guide#preview
                  focusin->cable-guide#preview
                  mouseleave->cable-guide#released
                  click->cable-guide#tuned"
     data-cable-guide-target="grid"
     data-window-start="<%= (window_start.to_f * 1000).round %>"
     data-window-hours="<%= window_hours %>"
     style="--guide-track: <%= track.call(window_hours) %>">

  <div class="tvguide__header">
    <%# Which day you are looking at, in a band of its own over the times.

        The label inside each band holds station against the gutter as that day scrolls
        past, exactly the way a programme's title does in its cell -- so the answer to
        "which day is this" is on screen at every scroll position within the day, not only
        when its left edge happens to be in view. Same two requirements as the title: the
        band must clip rather than scroll, and the label must be narrower than the band. %>
    <div class="tvguide__days">
      <div class="tvguide__days-gutter"></div>
      <div class="tvguide__days-track" style="width: <%= track.call(window_hours) %>">
        <% day_bands.each do |band| %>
          <div class="tvguide__day"
               style="left: <%= track.call(band[:from]) %>; width: <%= track.call(band[:to] - band[:from]) %>">
            <span class="tvguide__day-name"><%= cable_day(band[:day], @zone) %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="tvguide__times">
      <%# The corner cell is a running clock, as it was on the real thing -- the columns are
          half hours and none of them says what time it is now. It is also the way back:
          pressed, it takes the grid to the present, which is a long way from the far end of
          tomorrow. %>
      <button type="button" class="tvguide__corner" data-cable-guide-target="clock"
              title="Jump to what is on now" data-action="click->cable-guide#jumpToNow">
        <%= cable_clock(@now, @zone) %>
      </button>
      <div class="tvguide__columns" style="width: <%= track.call(window_hours) %>">
        <% columns.each do |column| %>
          <div class="tvguide__column" style="width: <%= track.call(0.5) %>">
            <%= cable_time(column, @zone).upcase %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="tvguide__rows">
    <% @rows.each do |row| %>
      <%
        channel = row[:channel]
        playing_here = @playing && @playing.id == channel.id
      %>
      <div class="tvguide__row <%= 'tvguide__row--tuned' if playing_here %>"
           data-channel-id="<%= channel.id %>">
        <%# The dial number and the channel's name, in the gutter the listings always had. %>
        <a class="tvguide__channel" href="<%= cable_channel_path(channel) %>"
           data-cinema-move="true" data-cable-guide-tune="<%= channel.id %>">
          <span class="tvguide__number"><%= row[:number] %></span>
          <span class="tvguide__callsign"><%= channel.name %></span>
        </a>

        <div class="tvguide__programmes" style="width: <%= track.call(window_hours) %>">
          <% row[:slots].each do |slot| %>
            <%
              left = hours.call(slot.starts_at)
              width = hours.call(slot.ends_at) - left
              # A programme that began before the window opened, or runs past its end, is
              # clipped -- the arrows say so, the way they did on cable.
              runs_in = slot.starts_at < window_start
              runs_on = slot.ends_at > @window.end
              # The show, and the episode of it, kept apart: the cell gets the show and the
              # panel gets the rest. See CableHelper::Programme for why.
              programme = cable_programme(slot)
              letterboxd_offered = current_user&.letterboxd_enabled? && letterboxd_reviewable?(slot.entry)
            %>
            <a class="tvguide__programme"
               href="<%= cable_channel_path(channel) %>"
               data-cinema-move="true"
               data-cable-guide-tune="<%= channel.id %>"
               <%# Everything the panel beside the picture shows, and the two marks the
                   clock needs to work out which cell is on right now. Milliseconds because
                   that is what the browser compares against. %>
               data-guide-start="<%= (slot.starts_at.to_f * 1000).round %>"
               data-guide-end="<%= (slot.ends_at.to_f * 1000).round %>"
               data-guide-channel="<%= channel.name %>"
               data-guide-channel-url="<%= list_path(channel) %>"
               data-guide-number="<%= row[:number] %>"
               data-guide-title="<%= programme.show %>"
               <%# What the grid deliberately leaves out, for the panel to say once about
                   the one programme being pointed at. %>
               data-guide-episode="<%= programme.number %>"
               data-guide-episode-title="<%= programme.episode_title %>"
               data-guide-runtime="<%= cable_runtime(slot) %>"
               data-guide-rating="<%= cable_rating(slot) %>"
               data-guide-genre="<%= cable_genres(slot) %>"
               <%# Letterboxd catalogues films, so the mark is offered on films only, and
                   only to a member who has linked an account -- the same two guards the
                   watch page's own Letterboxd button leans on. The score is this member's
                   own, read from the batch rather than per cell. %>
               <% if letterboxd_offered %>
                 data-guide-letterboxd-url="<%= letterboxd_review_path(slot.entry) %>"
                 data-guide-letterboxd-score="<%= @letterboxd[slot.entry_id] %>"
               <% end %>
               <%# What the heart acts on, and whether it is already filled. A favourite is
                   a copy filed in the member's own channel, so "already there" is a
                   question about the film rather than about this row's id. %>
               data-guide-entry-id="<%= slot.entry_id %>"
               data-guide-favorited="<%= @favorited.include?(slot.entry.catalogue_key) %>"
               <%# Where this programme lives outside the schedule: its own page on the
                   watch side, played from the beginning the ordinary way. %>
               data-guide-watch-url="<%= watch_entry_path(slot.entry, channel: channel.id,
                                                          subentry: slot.subentry&.id) %>"
               data-guide-year="<%= slot.entry.year %>"
               data-guide-plot="<%= slot.entry.plot %>"
               data-guide-watched="<%= @watched.include?(slot.entry_id) %>"
               style="left: <%= track.call(left) %>; width: <%= track.call(width) %>">
              <%# Pinned to the cell's own edges rather than sitting in the flow, so the
                  title between them is free to slide as the day scrolls past. %>
              <% if runs_in %><span class="tvguide__arrow tvguide__arrow--in">&#9664;</span><% end %>
              <span class="tvguide__name"><%= programme.show %></span>
              <% if runs_on %><span class="tvguide__arrow tvguide__arrow--out">&#9654;</span><% end %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Midnight, drawn down the whole dial. The same reasoning as the line below: it is a
        fact about the time and crosses every channel at once. Days are what the track is
        made of now, and a boundary you can see is the difference between reading a listing
        and counting columns backwards from the present. %>
    <% columns.select { |column| column.in_time_zone(@zone).hour.zero? && column.in_time_zone(@zone).min.zero? }.each do |midnight| %>
      <div class="tvguide__daybreak" style="--guide-day-hours: <%= hours.call(midnight).round(5) %>"></div>
    <% end %>

    <%# Where we are on the track. Drawn over the rows rather than in one of them, because
        it is a fact about the time and crosses every channel at once. Its position is set
        by the clock rather than by this render -- see cable_guide_controller. %>
    <div class="tvguide__now" data-cable-guide-target="nowLine"></div>
  </div>
</div>
