<%= render 'shared/player_preconnect', url: @embed_url, source: @entry.resolved_source %>

<script nonce="<%= content_security_policy_nonce %>">
  // Same two guards the watch page keeps, and for the same reasons: the embed is a third
  // party's page and will open windows and navigate its parent given the chance.
  window.open = function () { return null; };

  window.addEventListener('beforeunload', function (e) {
    if (window.leavingOnPurpose) return;

    if (document.activeElement && document.activeElement.tagName === 'IFRAME') {
      e.preventDefault();
      e.returnValue = '';
      return '';
    }
  });
</script>

<%# The same three parts as the watch page, and the same reasons for the split (see
    entries/watch.html.erb): the screen is what goes fullscreen and must survive a change of
    channel, the frame stack holds the player, and the chrome is everything that describes
    what is on right now and is replaced wholesale when the channel changes.

    The ids are the watch page's ids on purpose. cinema-navigation finds its frame and its
    chrome by name, so changing channel here costs exactly what it costs there -- including
    the channel below being warmed in a second frame -- with no cable-specific copy of it. %>
<div class="cinema__screen"
     data-controller="cinema-fullscreen cinema-navigation"
     <%# The clock asking to move on is answered the same way the up-next card is on the
         watch page: the navigation controller fetches the next page and pastes it in, so
         the player's frame and any fullscreen survive the change of programme. %>
     data-action="cable-clock:move@document->cinema-navigation#moveFromEvent
                  player-keys:fullscreen@document->cinema-fullscreen#toggle"
     data-cinema-fullscreen-idle-class="cinema__screen--idle"
     data-cinema-navigation-moving-class="cinema__screen--moving"
     data-cinema-navigation-preload-value="true"
     <%# What the entries sidebar's script writes on the watch page. Nothing writes it here,
         and the unset default is placed for a sidebar this page does not have. %>
     style="--watch-controls-right: 120px;">

  <div id="cinema-frames" class="cinema__frames">
    <%# No `allowfullscreen`: fullscreen belongs to the container, exactly as on the watch
        page. See cinema_fullscreen_controller.js. %>
    <iframe id="cinema"
            class="cinema__frame cinema__frame--live"
            title="<%= @entry.name %>"
            referrerpolicy="origin"
            allow="autoplay"
            src="<%= @embed_url %>"></iframe>
  </div>

  <button type="button" class="cinema__fullscreen" title="Fullscreen"
          data-action="click->cinema-fullscreen#toggle">
    <i class="fa-solid fa-expand"></i>
  </button>

  <div id="cinema-chrome"
       <%# player-keys but not player-progress. Pausing and seeking are the player's own
           controls and a viewer may have them; where they got to is not recorded, because
           on a cable channel where you got to is decided by the clock and is nobody's
           property. %>
       data-controller="player-keys cable-clock"
       <%# Which adapter drives this page's player, for anything that needs to reach it --
           cinema-navigation reads it off the fetched page to know how to quieten the
           channel it is warming. Its own attribute rather than one controller's value,
           because it describes the player and not any one reader of it. %>
       data-player-adapter="<%= @entry.resolved_source&.sync_adapter %>"
       data-player-keys-adapter-value="<%= @entry.resolved_source&.sync_adapter %>"
       data-player-keys-frame-value="cinema"
       data-cable-clock-frame-value="cinema"
       data-cable-clock-adapter-value="<%= @entry.resolved_source&.sync_adapter %>"
       <%# Where to go when this programme is over: the channel itself, which answers with
           whatever the schedule says is on by the time the request lands. %>
       data-cable-clock-url-value="<%= cable_channel_path(@channel) %>"
       data-cable-clock-ends-at-value="<%= @slot.ends_at.utc.iso8601 %>">

    <div class="cinema__title">
      <h3 class="d-flex align-items-center">
        <%= link_to @channel.name, list_path(@channel), class: 'text-white text-decoration-none me-2' %>
      </h3>
      <h1><%= @entry.name %></h1>
      <% if @current_subentry && @entry.media == 'anime' %>
        <h3>E<%= @current_subentry.calculate_absolute_episode_number %> - <%= @current_subentry.name %></h3>
      <% elsif @current_subentry %>
        <h3><%= @entry.series.presence || @entry.name %></h3>
        <h3>S<%= @current_subentry.season %>E<%= @current_subentry.episode %> - <%= @current_subentry.name %></h3>
      <% elsif @entry.media == 'episode' %>
        <h3><%= @entry.series %> - S<%= @entry.season %>E<%= @entry.episode %></h3>
      <% end %>

      <%# Inside the title rather than beside it: the title is one line for a film and four
          for an episode of a series, so a listing placed at a fixed offset below it sits on
          the episode name half the time. Flowing under it also means it inherits the one
          rule that moves the title when the left sidebar opens, instead of needing a copy
          of that rule that can drift from it. %>
      <%= render 'cable/now_next', slot: @slot, upcoming: @upcoming, now: @now %>
    </div>

    <%# The watch page's ring, with the four controls that mean something here. There is no
        next or previous entry to move to -- the running order is the schedule's, not the
        viewer's -- so the left and right arrows and the shuffle are gone, and the up and
        down arrows change channel as they do there. %>
    <div id="watchCinemaControls" class="d-flex justify-content-center cinema__control cinema__control--watch">
      <div class="position-relative" style="width: 80px; height: 80px;">
        <%= link_to cable_channel_path(CableSchedule.sibling(@channel, :previous)),
                    data: { cinema_move: true } do %>
          <i class="fa-solid fa-3x fa-caret-up position-absolute top-0 start-50 translate-middle-x"></i>
        <% end %>

        <%# Marking something watched is the one write on this page, and it is one the
            viewer asked for rather than a consequence of the channel having been on. Signed
            out there is no account to mark it against, so the control is left out. %>
        <% if user_signed_in? %>
          <div class="position-absolute top-0 start-0 translate-middle-y">
            <%= render 'entries/completion_status', entry: @entry, user: current_user %>
          </div>
        <% end %>

        <%# Warmed as well as moved, the same as on the watch page: down the dial is the
            direction somebody surfing travels. %>
        <%= link_to cable_channel_path(CableSchedule.sibling(@channel, :next)),
                    data: { cinema_move: true, cinema_preload: true } do %>
          <i class="fa-solid fa-3x fa-caret-down position-absolute bottom-0 start-50 translate-middle-x"></i>
        <% end %>

        <%= link_to root_path, class: 'text-decoration-none' do %>
          <i class="fa-solid fa-house fa-2x position-absolute top-50 start-50 translate-middle"></i>
        <% end %>
      </div>
    </div>

    <%# Marking a reviewable channel's film watched opens this, exactly as on the watch
        page -- _completion_status points both at the same #reviewModal. %>
    <% if user_signed_in? %>
      <%= render 'entries/review_modal' %>
    <% end %>
  </div>
</div>
