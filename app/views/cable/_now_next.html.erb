<%# What is on and what follows -- the listing off the back page, for a channel whose
    running order the viewer does not choose and cannot see any other way.

    Inside the chrome, so a change of channel replaces it along with everything else that
    names the current programme. The bar fills itself from the clock: the two times are the
    only things the server tells it, because everything else it needs is what time it is. %>
<div class="cable__guide"
     data-controller="cable-progress"
     data-cable-progress-starts-at-value="<%= slot.starts_at.utc.iso8601 %>"
     data-cable-progress-ends-at-value="<%= slot.ends_at.utc.iso8601 %>">
  <div class="cable__guide-now">
    <span class="cable__guide-label">On now</span>
    <div class="cable__guide-bar">
      <div class="cable__guide-fill" data-cable-progress-target="fill"></div>
    </div>
    <span class="cable__guide-time">
      <%= cable_time(slot.starts_at) %> &ndash; <%= cable_time(slot.ends_at) %>
      <span data-cable-progress-target="remaining"></span>
    </span>
  </div>

  <% if upcoming.any? %>
    <ol class="cable__guide-next">
      <% upcoming.each do |next_slot| %>
        <li>
          <span class="cable__guide-time"><%= cable_time(next_slot.starts_at) %></span>
          <span class="cable__guide-name"><%= cable_programme_name(next_slot) %></span>
        </li>
      <% end %>
    </ol>
  <% end %>
</div>
