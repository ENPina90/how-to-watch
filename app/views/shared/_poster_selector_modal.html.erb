<%# One poster picker for the whole page. It used to be rendered per entry, which put a
    copy in the DOM for every card on a list. The entry to work on arrives with the
    Bootstrap trigger (shared/_poster_selector_button) as `event.relatedTarget`. %>
<div
  class="modal fade"
  id="posterModal"
  tabindex="-1"
  aria-labelledby="posterModalLabel"
  aria-hidden="true"
  data-controller="poster-selector"
  data-poster-selector-target="modal"
  >
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="posterModalLabel" data-poster-selector-target="title">Choose Poster</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div data-poster-selector-target="loading" class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-3">Finding available posters...</p>
        </div>
        <div data-poster-selector-target="results" class="row g-3" style="display: none;"></div>
        <div data-poster-selector-target="error" class="alert alert-warning" style="display: none;" role="alert">
          No posters found. Upload one below, or try again.
        </div>
      </div>
      <%# Outside the three states above, so it is there whether the search found nothing,
          something, or is still looking -- "none of these is any good" is the case it
          exists for, and that is not the same as "there were none". %>
      <div class="modal-footer justify-content-between align-items-end">
        <div class="poster-upload">
          <label class="form-label mb-1" for="posterUpload">None of these? Upload your own.</label>
          <input type="file"
                 id="posterUpload"
                 class="form-control form-control-sm"
                 accept="image/jpeg,image/png,image/webp,image/gif"
                 data-poster-selector-target="file"
                 data-action="change->poster-selector#upload">
        </div>
        <p class="mb-0 small" data-poster-selector-target="uploadStatus"></p>
      </div>
    </div>
  </div>
</div>
