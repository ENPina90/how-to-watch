<%# Source switcher for the transient watch_now page. No Entry exists here, so buttons
    swap the iframe src client-side. All providers are treated as imdb-kind. Buttons are
    numbered rather than named -- the provider's name is the tooltip. %>
<% imdb_sources = Source.active.where(kind: 'imdb').order(:position) %>

<div class="source-switcher source-switcher--watch-now d-flex align-items-center gap-2 flex-wrap justify-content-center">
  <% rendered = 0 %>
  <% imdb_sources.each do |source| %>
    <% url = source.build_url(@source_media_key, @source_vars, autoplay: true) %>
    <% next if url.blank? %>
    <%# `rendered` and not the loop index: a provider with no URL for this title is
        skipped, and the numbering has to stay unbroken on the page. %>
    <button type="button"
            class="btn btn-sm source-switcher__btn <%= 'source-switcher__btn--active' if rendered.zero? %>"
            data-src="<%= url %>"
            title="<%= source.name %>"
            onclick="watchNowSetSource(this)">
      Source <%= rendered + 1 %>
    </button>
    <% rendered += 1 %>
  <% end %>

  <% if current_user&.admin? %>
    <button type="button" class="btn btn-sm source-switcher__icon"
            data-bs-toggle="modal" data-bs-target="#manageSourcesModal" title="Edit sources">
      <i class="fa-solid fa-pen"></i>
    </button>
    <button type="button" class="btn btn-sm source-switcher__icon"
            data-bs-toggle="modal" data-bs-target="#newSourceModal" title="Add a new source">
      <i class="fa-solid fa-plus"></i>
    </button>
  <% end %>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  function watchNowSetSource(btn) {
    var frame = document.getElementById('cinema');
    if (frame) frame.src = btn.dataset.src;
    document.querySelectorAll('.source-switcher__btn').forEach(function (b) {
      b.classList.remove('source-switcher__btn--active');
    });
    btn.classList.add('source-switcher__btn--active');
  }
</script>

<% if current_user&.admin? %>
  <%= render 'sources/new_modal' %>
  <%= render 'sources/manage_modal' %>
<% end %>
