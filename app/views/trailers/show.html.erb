<%# /trailers. The cable page's screen without the cable page's schedule: a trailer plays, and
    when it ends -- or YouTube refuses it -- trailer-reel asks for the next, which
    cinema-navigation fetches and pastes in the way it changes a channel, so the screen and
    any fullscreen survive it. Channel 0 on /cable is this reel with the dial around it. %>
<%= render 'cable/frame_guards' %>

<div class="cinema__screen"
     data-controller="cinema-fullscreen cinema-navigation"
     data-action="trailer-reel:next@document->cinema-navigation#moveFromEvent
                  player-keys:fullscreen@document->cinema-fullscreen#toggle"
     data-cinema-fullscreen-idle-class="cinema__screen--idle"
     data-cinema-fullscreen-always-value="true"
     data-cinema-fullscreen-idle-delay-value="4000"
     data-cinema-navigation-moving-class="cinema__screen--moving">

  <div id="cinema-frames" class="cinema__frames">
    <%# No `allowfullscreen`: fullscreen belongs to the container, as on every player page. %>
    <iframe id="cinema"
            class="cinema__frame cinema__frame--live"
            title="<%= @trailer ? "#{@trailer.entry.name} trailer" : 'Trailers' %>"
            referrerpolicy="origin"
            allow="autoplay"
            src="<%= @trailer&.embed_url || 'about:blank' %>"></iframe>
  </div>

  <button type="button" class="cinema__fullscreen" title="Fullscreen"
          data-action="click->cinema-fullscreen#toggle">
    <i class="fa-solid fa-expand"></i>
  </button>

  <%# player-keys for fullscreen alone. No adapter is named: the reel plays itself from one
      trailer to the next, and trailer-reel listens to the embed on its own account. %>
  <div id="cinema-chrome"
       data-controller="player-keys trailer-reel"
       data-player-keys-frame-value="cinema"
       data-player-keys-transport-value="false"
       data-trailer-reel-frame-value="cinema"
       data-trailer-reel-url-value="<%= trailers_path %>">
    <% if @trailer %>
      <% entry = @trailer.entry %>
      <%# The film, not the trailer, is what this card is about: the trailer is already on
          screen, and the card is the way to the thing it is advertising. %>
      <div class="trailer-card">
        <%= link_to watch_entry_path(entry), class: 'trailer-card__poster', tabindex: -1, aria: { hidden: true } do %>
          <%= entry_poster_image_tag(entry, loading: 'eager', class: 'trailer-card__image') %>
        <% end %>

        <div class="trailer-card__body">
          <p class="trailer-card__eyebrow">Coming Attractions</p>
          <h1 class="trailer-card__title"><%= link_to entry.name, watch_entry_path(entry) %></h1>
          <p class="trailer-card__meta"><%= trailer_facts(entry) %></p>

          <div class="trailer-card__actions">
            <%= link_to watch_entry_path(entry), class: 'btn btn-primary btn-sm' do %>
              <i class="fa-solid fa-play me-1"></i>Watch the film
            <% end %>
            <button type="button" class="btn btn-outline-light btn-sm" title="Next trailer (→)"
                    data-action="click->trailer-reel#next">
              <i class="fa-solid fa-forward-step me-1"></i>Next trailer
            </button>
            <%= link_to root_path, class: 'btn btn-outline-light btn-sm', title: 'Home' do %>
              <i class="fa-solid fa-house"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="cable__off-air">
        <div class="cable__off-air-card">
          <h1>Coming Attractions</h1>
          <p class="text-muted">No trailers to show.</p>
          <p class="text-muted small">
            Trailers are fetched from TMDB when a film is added. Once a channel you can see has a
            film with one, it plays here.
          </p>
          <%= link_to 'Home', root_path, class: 'btn btn-outline-light mt-3' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
