<div id="top"></div>
<div data-search-target="results">
  <div class="row justify-content-between list-layout" data-controller="section-filter">
    <% unless minimal %>
      <div class="col-2 layout text-center">
        <a href="#top"><i class="fa-solid fa-sort-up fa-lg"></i></a>
        <div class="layout-box">
          <%# Each section is a filter toggle, not a jump link: several can be on at once
              and the entries are hidden and shown where they already stand. %>
          <% unless @criteria == 'Position' || @current.nil? %>
            <% sections.each do |section|%>
              <button type="button"
                      class="section-filter"
                      aria-pressed="false"
                      data-section="<%= section %>"
                      data-section-filter-target="option"
                      data-action="section-filter#toggle"><%= section %></button>
            <% end %>
          <% end %>
        </div>
        <a href="#footer"><i class="fa-solid fa-sort-down fa-lg"></i></a>
      </div>
    <% end %>
    <div class="<%= minimal ? 'col-12 px-4' : 'col-8' %>  d-flex justify-content-center">
        <% if minimal %>
          <div data-controller="sort" class="col-10">
            <% @position_items.each_with_index do |item, i| %>
              <% if item.is_a?(Entry) %>
                <%= render "entries/entry_minimal", entry: item, index: i + 1 %>
              <% else # List %>
                <%= render "lists/child_list_minimal", list: item, index: i + 1 %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div>
            <% if @criteria == 'Position' %>
              <!-- Show mixed entries and child lists in position order -->
              <% @position_items.each do |item| %>
                <% if item.is_a?(Entry) %>
                  <%= entry_card(item) %>
                <% else # List %>
                  <%= render "lists/child_list_card", list: item %>
                <% end %>
              <% end %>
            <% else %>
              <!-- Show entries grouped by criteria (child lists not shown in other views) -->
              <%# `sections` is pre-sorted by the controller; keys mix numbers and strings. %>
              <%# Each section is its own element so that its sticky heading is pushed out
                  by the next one instead of the two stacking at the same offset. %>
              <% sections.each do |key| %>
                <section class="entry-section"
                         data-section="<%= key %>"
                         data-section-filter-target="section"
                         data-controller="section-collapse">
                  <h3 id="<%= key %>">
                    <%# A real button rather than a clickable heading, so the section can
                        be collapsed from the keyboard and reports its own state. %>
                    <button type="button"
                            class="section-toggle"
                            aria-expanded="true"
                            data-action="section-collapse#toggle">
                      <span><%= key %> <small>(<%= entries[key].count %>)</small></span>
                      <i class="fa-solid fa-chevron-down section-caret" aria-hidden="true"></i>
                    </button>
                  </h3>
                  <div data-section-collapse-target="body">
                    <% entries[key].each do |entry| %>
                      <% if minimal %>
                        <%= render "entries/entry_minimal", entry: entry %>
                      <% else %>
                        <%= entry_card(entry) %>
                      <% end %>
                    <% end %>
                  </div>
                </section>
              <% end %>
            <% end %>
          </div>
        <% end %>
    </div>
    <% unless minimal %>
      <div class="col-2 layout" data-controller="randomize">
        <%= render 'upnext', random_selection: @random_selection unless @current.nil?%>
      </div>
    <% end %>
  </div>
</div>
