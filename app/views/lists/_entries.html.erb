<div id="top"></div>
<div data-search-target="results">
  <div class="row justify-content-center list-layout"
       data-controller="section-filter"
       data-channel-criteria="<%= @criteria %>">
    <%# Up Next and the section filters share one panel now. It is fixed to the right edge
        rather than being a column, so the entries keep the middle of the page. %>
    <% unless minimal %>
      <%= render 'shared/channel_sidebar', list: @list, filters: @filters,
                                           sources: @sources || [],
                                           random_selection: random_selection %>
    <% end %>
    <div class="<%= minimal ? 'col-12 px-4' : 'col-8' %>  d-flex justify-content-center">
        <% if minimal %>
          <div class="col-10">
            <%# Acts on the ticked rows below. Outside the sort container, which would
                otherwise treat the toolbar as a row that can be dragged. %>
            <% if current_user&.can_edit_list?(@list) %>
              <div class="bulk-toolbar">
                <label class="bulk-toolbar__all">
                  <input type="checkbox" class="form-check-input mt-0"
                         data-bulk-select-target="all" data-action="change->bulk-select#toggleAll">
                  Select all
                </label>
                <span class="bulk-toolbar__count"><span data-bulk-select-target="count">0</span> selected</span>
                <%# First of the three, and the only one that is nobody else's business: it
                    records that *you* have watched them. Edit and Delete change the entries
                    themselves, for everyone the channel is shared with. %>
                <%= form_with url: complete_list_bulk_entries_path(@list), method: :patch, class: "d-inline",
                              data: { action: "submit->bulk-select#confirmComplete" } do %>
                  <button type="submit" class="btn btn-sm btn-outline-success" disabled
                          data-bulk-select-target="action">
                    <i class="fa-solid fa-check"></i> Watched
                  </button>
                <% end %>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                        data-bs-toggle="modal" data-bs-target="#bulkEditModal"
                        data-bulk-select-target="action">
                  <i class="fa-solid fa-pen"></i> Edit
                </button>
                <%= form_with url: list_bulk_entries_path(@list), method: :delete, class: "d-inline",
                              data: { action: "submit->bulk-select#confirmDelete" } do %>
                  <button type="submit" class="btn btn-sm btn-outline-danger" disabled
                          data-bulk-select-target="action">
                    <i class="fa-solid fa-trash"></i> Delete
                  </button>
                <% end %>
              </div>
            <% end %>
            <%# The move URL is what lets a ticked row carry the others with it when dragged,
                so it is only there for somebody who may reorder the channel. The direction
                is how the server reads "dropped below this row" on a reversed page. %>
            <div data-controller="sort"
                 <% if current_user&.can_edit_list?(@list) %>data-sort-move-url-value="<%= move_list_bulk_entries_path(@list) %>"<% end %>
                 data-sort-direction-value="<%= @direction %>">
              <% @position_items.each_with_index do |item, i| %>
                <% if item.is_a?(Entry) %>
                  <%= render "entries/entry_minimal", entry: item, index: i + 1 %>
                <% else # List %>
                  <%= render "lists/child_list_minimal", list: item, index: i + 1 %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% else %>
          <div>
            <% if @criteria == 'Position' %>
              <!-- Show mixed entries and child channels in position order -->
              <%# Named so a newly added entry can be appended here without a reload. Only
                  this view has an end that a new entry belongs at: a grouped one would
                  have to be told which section to put it in. %>
              <div id="list-entries">
                <% @position_items.each do |item| %>
                  <% if item.is_a?(Entry) %>
                    <%= render 'lists/position_item', item: item %>
                  <% else # List %>
                    <%= render 'lists/position_item', item: item %>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <%# A child channel has no year, genre or category to be filed under, so a
                  grouped view has no section for it -- and used to leave it off the page
                  entirely, which made adding one look like nothing had happened. They sit
                  above the sections instead, where the grouping does not apply to them. %>
              <% if params[:query].blank? && @child_lists.any? %>
                <div class="child-channels">
                  <% @child_lists.each do |child| %>
                    <%= render 'lists/position_item', item: child %>
                  <% end %>
                </div>
              <% end %>

              <!-- Show entries grouped by criteria -->
              <%# `sections` is pre-sorted by the controller; keys mix numbers and strings. %>
              <%# Each section is its own element so that its sticky heading is pushed out
                  by the next one instead of the two stacking at the same offset. %>
              <% sections.each do |key| %>
                <section class="entry-section"
                         id="<%= section_id(key) %>"
                         data-section="<%= key %>"
                         data-section-filter-target="section"
                         data-controller="section-collapse">
                  <h3 id="<%= key %>">
                    <%# A real button rather than a clickable heading, so the section can
                        be collapsed from the keyboard and reports its own state. %>
                    <button type="button"
                            class="section-toggle"
                            aria-expanded="true"
                            data-action="section-collapse#toggle">
                      <span><%= section_label(@criteria, key) %> <small id="<%= section_count_id(key) %>">(<%= entries[key].count %>)</small></span>
                      <i class="fa-solid fa-chevron-down section-caret" aria-hidden="true"></i>
                    </button>
                  </h3>
                  <div id="<%= section_body_id(key) %>" data-section-collapse-target="body">
                    <% entries[key].each do |entry| %>
                      <%# One wrapper per card so the source filter can hide a single
                          entry: the section around them holds entries from several
                          channels at once. %>
                      <div data-source="<%= entry.list_id %>" data-section-filter-target="card">
                        <% if minimal %>
                          <%= render "entries/entry_minimal", entry: entry %>
                        <% else %>
                          <%= entry_card(entry) %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </section>
              <% end %>
            <% end %>
          </div>
        <% end %>
    </div>
  </div>
</div>
