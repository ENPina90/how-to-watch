<div class="lists-index-container">
  <!-- Recently Watched Row (FIRST) -->
  <% if @recently_watched_lists.any? %>
    <div class="list-row">
      <h3 class="row-title">Continue Watching</h3>
      <div class="list-carousel pe-5">
        <% @recently_watched_lists.first(10).each do |list| %>
          <% current_entry = @card_entries[list.id] %>
          <div class="list-card">
            <% if current_entry %>
              <%= link_to card_play_path(current_entry, list), class: "text-decoration-none" do %>
                <div class="list-card-poster">
                  <%= entry_poster_image_tag(current_entry, class: 'list-poster-img', alt: list.name) %>
                  <div class="list-card-overlay">
                    <i class="fa-solid fa-play fa-3x"></i>
                  </div>
                </div>
              <% end %>
            <% else %>
              <%= link_to list_path(list), class: "text-decoration-none" do %>
                <div class="list-card-poster">
                  <img src="/images/please_stand_by.png" alt="<%= list.name %>" class="list-poster-img">
                  <div class="list-card-overlay">
                    <i class="fa-solid fa-play fa-3x"></i>
                  </div>
                </div>
              <% end %>
            <% end %>
            <%= link_to list_path(list), class: "text-decoration-none list-info-link" do %>
              <div class="list-card-info">
                <div class="list-card-text">
                  <p class="list-card-name"><%= list.name %></p>
                  <p class="list-card-meta">
                    <% if current_entry %>
                      <%= current_entry.name %>
                    <% else %>
                      <i class="fa-solid fa-square-caret-right"></i> <%= list.entries_count %>
                    <% end %>
                  </p>
                </div>
                <i class="fa-solid fa-list list-info-icon"></i>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Your Channels Row (SECOND) -->
  <% if @your_lists.any? %>
    <div class="list-row">
      <div class="d-flex align-items-center">
        <h3 class="row-title">Your Channels</h3>
        <%= link_to new_list_path do %>
          <i class="fa-solid fa-plus ms-2" title="Create New Channel"></i>
        <% end %>
      </div>
      <div class="list-carousel pe-5">
        <% @your_lists.each do |list| %>
          <% current_entry = @card_entries[list.id] %>
          <div class="list-card">
            <% if current_entry %>
              <%= link_to card_play_path(current_entry, list), class: "text-decoration-none" do %>
                <div class="list-card-poster">
                  <%= entry_poster_image_tag(current_entry, class: 'list-poster-img', alt: list.name) %>
                  <div class="list-card-overlay">
                    <i class="fa-solid fa-play fa-3x"></i>
                  </div>
                </div>
              <% end %>
            <% else %>
              <%= link_to list_path(list), class: "text-decoration-none" do %>
                <div class="list-card-poster">
                  <img src="/images/please_stand_by.png" alt="<%= list.name %>" class="list-poster-img">
                  <div class="list-card-overlay">
                    <i class="fa-solid fa-play fa-3x"></i>
                  </div>
                </div>
              <% end %>
            <% end %>
            <%= link_to list_path(list), class: "text-decoration-none list-info-link" do %>
              <div class="list-card-info">
                <div class="list-card-text">
                  <p class="list-card-name"><%= list.name %></p>
                  <p class="list-card-meta"><i class="fa-solid fa-square-caret-right"></i> <%= list.entries_count %></p>
                </div>
                <i class="fa-solid fa-list list-info-icon"></i>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>


  <!-- Community Channels Row -->
  <% if @community_lists.any? %>
    <div class="list-row">
      <h3 class="row-title">Community Channels</h3>
      <div class="list-carousel pe-5">
        <% @community_lists.each do |list| %>
          <% current_entry = @card_entries[list.id] %>
          <div class="list-card">
            <% if current_entry %>
              <%= link_to card_play_path(current_entry, list), class: "text-decoration-none" do %>
                <div class="list-card-poster">
                  <%= entry_poster_image_tag(current_entry, class: 'list-poster-img', alt: list.name) %>
                  <div class="list-card-overlay">
                    <i class="fa-solid fa-play fa-3x"></i>
                  </div>
                </div>
              <% end %>
            <% else %>
              <%= link_to list_path(list), class: "text-decoration-none" do %>
                <div class="list-card-poster">
                  <img src="/images/please_stand_by.png" alt="<%= list.name %>" class="list-poster-img">
                  <div class="list-card-overlay">
                    <i class="fa-solid fa-play fa-3x"></i>
                  </div>
                </div>
              <% end %>
            <% end %>
            <%# The card's info block used to be one link to the channel, owner's name and
                all. The name is a link of its own now -- to whoever made the channel -- and
                an anchor cannot hold another anchor, so the block is a div and the two
                links inside it say where each goes. `display_name` rather than the
                username-or-email-prefix this repeated by hand: the same answer, from the
                one place that gives it. %>
            <div class="list-card-info list-info-link">
              <div class="list-card-text">
                <%= link_to list.name, list_path(list), class: "list-card-name" %>
                <p class="list-card-meta">
                  <i class="fa-solid fa-square-caret-right"></i> <%= list.entries_count %> ·
                  <i class="fa-solid fa-user"></i>
                  <%= link_to list.user.display_name, member_path(list.user), class: "list-card-owner" %>
                </p>
              </div>
              <%= link_to list_path(list), class: "text-decoration-none", aria: { label: "Open #{list.name}" } do %>
                <i class="fa-solid fa-list list-info-icon"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
