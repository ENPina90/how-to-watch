<div class="container" data-controller="edit search entry-anchor" data-search-id-value="<%= @list.id %>">
  <div class="row justify-content-center layout-title" data-controller="sticky-headers">
    <% unless @list.top_level? %>
      <nav aria-label="breadcrumb" class="mb-2">
        <% if @list.parent_lists.size == 1 %>
          <!-- Single parent path -->
          <ol class="breadcrumb justify-content-center">
            <% @list.primary_ancestors.reverse.each do |ancestor| %>
              <li class="breadcrumb-item">
                <%= link_to ancestor.name, list_path(ancestor), class: "text-decoration-none" %>
              </li>
            <% end %>
            <li class="breadcrumb-item active" aria-current="page"><%= @list.name %></li>
          </ol>
        <% else %>
          <!-- Multiple parent paths -->
          <div class="text-center">
            <small class="text-muted">This channel appears in:</small>
            <div class="d-flex flex-wrap justify-content-center gap-2 mt-1">
              <% @list.parent_lists.each do |parent| %>
                <span class="badge bg-secondary">
                  <%= link_to parent.name, list_path(parent), class: "text-white text-decoration-none" %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </nav>
    <% end %>
    <h1 class="text-center">
      <%= render 'lists/header_count', count: @list.total_entry_count, list: @list %>
      - <%= link_to @list.name, list_path(@list) %>
    </h1>
    <div class="list-input">
      <%# Everything you do *to* the channel is on the right; subscribing to it and putting
          things in it are on the left, where the search can grow without moving them. %>
      <div class="list-actions">
        <%= render 'lists/subscription_button', list: @list, user: current_user %>
        <%= link_to new_list_entry_path(@list), class: "list-action", title: "Add an entry" do %>
          <i class="fa-solid fa-circle-plus"></i>
        <% end %>

        <%= link_to list_vote_path(@list), class: "list-action", title: "Put some up for a vote" do %>
          <i class="fa-solid fa-check-to-slot"></i>
        <% end %>

        <%= form_with url: list_path(@list), method: :get,
                      class: "expanding-search",
                      data: { controller: "expanding-search" } do %>
          <button type="button" class="list-action" title="Search this channel"
                  data-action="click->expanding-search#open">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
          <%= text_field_tag :query,
                             params[:query],
                             class: "form-control expanding-search__field",
                             data: { search_target: "input", expanding_search_target: "field" },
                             placeholder: "Search this channel" %>
        <% end %>
      </div>
      <div class="list-options">
        <div data-controller="view-toggle" data-view-toggle-url-value="<%= request.path %>">
          <% if params[:view] == "minimal" %>
            <i class="fa-solid fa-up-right-and-down-left-from-center" data-action="click->view-toggle#toggleView"  data-view-toggle-target="icon"></i>
          <% else %>
            <i class="fa-solid fa-down-left-and-up-right-to-center" data-action="click->view-toggle#toggleView"  data-view-toggle-target="icon"></i>
          <% end %>
        </div>
        <%# <i class="fa-solid fa-up-right-and-down-left-from-center"></i> %>
        <i class="fa-solid fa-copy"></i>
        <% if current_user&.can_edit_list?(@list) %>
          <%= link_to edit_list_path(@list) do %>
            <i class="fa-solid fa-pen"></i>
          <% end %>
          <div class="dropdown d-inline">
            <button class="btn btn-link p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-arrows-up-down-left-right"></i>
            </button>
            <div class="dropdown-menu" style="min-width: 250px;">
              <h6 class="dropdown-header">Add to another channel:</h6>
              <%= form_with url: list_move_to_list_path(@list), method: :patch, class: "px-3 mb-2" do |f| %>
                <%= f.select :target_list_id,
                    options_from_collection_for_select(
                      current_user.lists.where.not(id: @list.id).select { |list| @list.can_be_added_to?(list) },
                      :id, :name
                    ),
                    { prompt: 'Select a channel...' },
                    { class: 'form-select form-select-sm mb-2', onchange: 'this.form.submit()' } %>
              <% end %>

              <% unless @list.parent_lists.empty? %>
                <div class="dropdown-divider"></div>
                <h6 class="dropdown-header">Remove from:</h6>
                <% @list.parent_lists.each do |parent| %>
                  <%= link_to list_move_to_list_path(@list, remove_from: parent.id),
                      method: :patch,
                      class: "dropdown-item text-danger",
                      data: { turbo_confirm: "Remove '#{@list.name}' from '#{parent.name}'?" } do %>
                    <i class="fa-solid fa-minus"></i> <%= parent.name %>
                  <% end %>
                <% end %>

                <div class="dropdown-divider"></div>
                <%= link_to list_move_to_list_path(@list),
                    method: :patch,
                    class: "dropdown-item text-danger",
                    data: { turbo_confirm: "Remove '#{@list.name}' from all parent channels?" } do %>
                  <i class="fa-solid fa-trash"></i> Remove from all parents
                <% end %>
              <% end %>
            </div>
          </div>
          <%= link_to list_path(@list), method: :delete, data: {turbo_method: :delete, turbo_confirm: 'Are you sure?'} do %>
            <i class="fa-solid fa-trash"></i>
          <% end %>
        <% end %>

        <%= render 'lists/default_toggle', list: @list, user: current_user %>

      </div>
    </div>
    <% unless @minimal %>
      <ul class="menu">
        <%# criteria_label is the one place a grouping's stored name and its word differ:
            the channel's own order is stored as Position and reads as Order. %>
        <% %w[Position Year Rating Genre Category Watched Media Length].each do |criteria| %>
          <li class="<%= 'active' if @criteria == criteria %>">
            <%= sort_menu_link(@list, criteria, criteria_label(criteria)) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <div id="entries-container">
    <%= render "entries", list: @list, entries: @entries, sections: @sections, random_selection: @random_selection, list_entries: @list_entries, minimal: @minimal%>
  </div>

  <%# Three modals for the whole page, not three per card. %>
  <%= render 'entries/review_modal_list' %>
  <%= render 'shared/trailer_modal' %>
  <%= render 'shared/poster_selector_modal' %>
  <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog" data-edit-target="modal">
    </div>
  </div>
</div>
