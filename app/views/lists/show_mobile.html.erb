<%# A channel on a phone: what is in it, as posters. Tap one and it turns over to say what
    it is. There is no play button anywhere on this page -- the phone view does not play --
    so the only things a card does are turn over and be marked watched. %>
<h1 class="m-heading"><%= @list.name %></h1>

<% if @mobile_entries.any? %>
  <div class="m-grid">
    <% @mobile_entries.each do |entry| %>
      <%= render "lists/mobile_entry", entry: entry, user: current_user %>
    <% end %>
  </div>
<% else %>
  <p class="m-empty">
    Nothing on this channel yet.<br>
    Search above to add something.
  </p>
<% end %>
