<%= simple_form_for @list do |f| %>
  <%= f.input :name %>
  <%= f.input :description, as: :text, input_html: { rows: 3 }, hint: 'Optional description of this channel' %>
  <%= f.input :ordered, as: :boolean %>
  <%= f.input :private, as: :boolean %>
  <%= f.input :reviewable, as: :boolean, label: 'Enable review prompts', hint: 'Ask for ratings and comments when marking entries as watched' %>
  <% if current_user&.can_set_default? %>
    <%= f.input :default, as: :boolean, label: 'Set as default channel', hint: 'Default channels are visible to all users' %>
  <% end %>
  <%= f.input :sort, collection: ['Year', 'Genre', 'Watched', 'Type', 'Length'], include_blank: true %>
  <%= f.association :provider, collection: Source.active.order(:position), label_method: ->(s) { "#{s.name} (#{s.kind})" }, include_blank: false, label: 'Default source provider', hint: 'Provider used for entries in this channel that don\'t override it' %>
  <%= f.input :auto_play, as: :boolean, label: 'Auto Play', hint: 'Automatically start playing entries when opened' %>
  <%= f.input :auto_next, as: :boolean, label: 'Auto Next', hint: 'Automatically advance to next entry when current one is completed' %>
  <%= f.button :submit %>
<% end %>

<%# A member's favourite channel is a property of the member, not of the channel, so it is
    a control of its own rather than a field on the form above. Only the owner sees it: a
    default channel somebody else owns is editable here, but not favouritable. %>
<% if current_user && @list.user_id == current_user.id %>
  <div class="mt-4 border-t pt-4">
    <h5>Favourite Channel</h5>
    <% if current_user.favorite?(@list) %>
      <p class="text-muted mb-2">
        This is your favourite channel. It is where <strong>Add to Favourites</strong> files
        anything you save, and the channel the mobile view opens on.
      </p>
      <%= link_to "Remove as Favourite", list_toggle_favorite_path(@list),
          class: "btn btn-outline-secondary btn-sm",
          data: { turbo_method: :patch } %>
    <% else %>
      <p class="text-muted mb-2">
        Make this the channel <strong>Add to Favourites</strong> files into.
        <% if current_user.favorite_list %>
          It will replace <strong><%= current_user.favorite_list.name %></strong> — you can
          only have one favourite.
        <% end %>
      </p>
      <%= link_to "Set as Favourite", list_toggle_favorite_path(@list),
          class: "btn btn-primary btn-sm",
          data: { turbo_method: :patch } %>
    <% end %>
  </div>
<% end %>

<div class="mt-4 border-t pt-4">
  <h5>Bulk Actions</h5>
  <div class="d-flex gap-2">
    <%= link_to "Mark All Complete",
        "/lists/#{@list.id}/mark_all_complete",
        method: :patch,
        class: "btn btn-success btn-sm",
        data: {
          confirm: "Are you sure you want to mark all #{pluralize(@list.entries.count, 'entry')} in this channel as complete?"
        } %>

    <%= link_to "Mark All Incomplete",
        "/lists/#{@list.id}/mark_all_incomplete",
        method: :patch,
        class: "btn btn-warning btn-sm",
        data: {
          confirm: "Are you sure you want to mark all #{pluralize(@list.entries.count, 'entry')} in this channel as incomplete?"
        } %>
  </div>
</div>
