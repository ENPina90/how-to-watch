<%# The phone home page: the channels this member follows and nothing else.
    Their own favourites first, because that is the one they came for most of the time.
    The field in the bar filters these rows -- see mobile_shell_controller. %>
<h1 class="m-heading">Your channels</h1>

<% if @mobile_channels.any? %>
  <div class="m-channels" data-mobile-shell-target="channels">
    <% @mobile_channels.each do |channel| %>
      <%= link_to list_path(channel), class: "m-channel #{'m-channel--favourite' if channel == @favorites_list}",
                  data: { mobile_shell_target: "channel", name: channel.name.downcase } do %>
        <span class="m-channel__mark">
          <i class="fa-<%= channel == @favorites_list ? 'solid fa-heart' : 'regular fa-bookmark' %>"></i>
        </span>
        <span class="m-channel__name"><%= channel.name %></span>
        <span class="m-channel__count"><%= channel.entries_count %></span>
      <% end %>
    <% end %>
  </div>

  <%# Shown by the filter when it matches nothing, so an empty screen says why. %>
  <p class="m-empty" data-mobile-shell-target="noMatches" hidden>No channel by that name.</p>
<% else %>
  <p class="m-empty">
    You are not following any channels yet.<br>
    Subscribe to one on the full site and it will be here.
  </p>
<% end %>
