<%# The id is what the subscribe/unsubscribe turbo stream replaces, so it stays on the
    outer element whichever state is rendered. %>
<span id="subscription-<%= list.id %>">
  <%# Nobody signed in: subscribing is not on offer, so neither is the pill. %>
  <% if user.nil? %>
  <% elsif user.subscribed_to?(list) %>
    <%= link_to list_unsubscribe_path(list),
        class: "subscription-pill subscription-pill--subscribed",
        data: { turbo_method: :patch } do %>
      <i class="fa-solid fa-check"></i>Subscribed
    <% end %>
  <% else %>
    <%= link_to list_subscribe_path(list),
        class: "subscription-pill",
        data: { turbo_method: :patch } do %>
      Subscribe
    <% end %>
  <% end %>
</span>
