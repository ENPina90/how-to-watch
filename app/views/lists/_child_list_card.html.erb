<%# A channel sitting inside another channel, in the shape of a series card: the poster of
    wherever you are up to, arrows to step through it, and the same menu. What a series
    card does with its episodes, this does with the channel's entries. %>
<% current = list.position_for_user(current_user)&.current_entry ||
             list.find_entry_by_position(:current, current_user) %>
<% total = list.entries.count %>
<% standing = current ? list.entries.where('position <= ?', current.position).count : 0 %>

<%= turbo_frame_tag dom_id(list) do %>
  <div class="card-container">
    <div class="grid-card channel-card" id="<%= dom_id(list) %>">
      <div class="card-picture">
        <%= link_to list_watch_current_path(list, channel: @viewing&.id), data: { turbo: false } do %>
          <% if current %>
            <%= entry_poster_image_tag(current) %>
          <% else %>
            <%= image_tag '/images/please_stand_by.png', class: 'entry-picture', alt: list.name %>
          <% end %>
          <span class="fa-stack fa-4x play-button">
            <i class="fa-solid fa-circle fa-stack-2x icon-background"></i>
            <i class="fa-solid fa-play fa-stack-1x icon-foreground"></i>
          </span>
        <% end %>
        <%# What tells this apart from an entry at a glance. %>
        <span class="channel-card__badge" title="A channel inside this one">
          <i class="fa-solid fa-folder me-1"></i>Channel
        </span>
      </div>

      <div class="card-stuff">
        <div class="card-title">
          <h5 class="card-header">
            <%# With a block, link_to's first argument is the url -- passing the name as
                well makes it read the path as html options. %>
            <%= link_to list_path(list), class: 'text-decoration-none' do %>
              <bold><%= list.name %></bold>
            <% end %>
          </h5>
        </div>

        <%# The same navigation the series card gives its episodes, over this channel's
            entries. It moves your own place in the channel and nobody else's. %>
        <div class="episode-navigation d-flex align-items-center justify-content-between border-top border-bottom py-3">
          <%= link_to list_previous_entry_path(list), class: 'text-decoration-none episode-nav-btn',
                      data: { turbo_method: :patch } do %>
            <i class="fa-solid fa-2x fa-chevron-left"></i>
          <% end %>

          <div class="current-episode-info text-center flex-grow-1 mx-3">
            <div class="episode-label mb-1">
              <strong><%= total.zero? ? 'Empty' : "#{standing} of #{total}" %></strong>
            </div>
            <div class="episode-name text-truncate">
              <%= current&.name || 'Nothing in here yet' %>
            </div>
          </div>

          <%= link_to list_next_entry_path(list), class: 'text-decoration-none episode-nav-btn',
                      data: { turbo_method: :patch } do %>
            <i class="fa-solid fa-2x fa-chevron-right"></i>
          <% end %>
        </div>

        <div class="card-details">
          <div class="d-flex justify-content-between">
            <p><%= current&.year %></p>
            <p><%= current&.rating %></p>
          </div>
          <p class="mb-4">
            <small>
              <%= pluralize(total, 'entry') %><%= " • #{pluralize(list.child_lists.count, 'channel')} inside" if list.child_lists.any? %>
            </small>
          </p>
          <p class="card-plot"><%= current&.plot.presence || list.description %></p>
        </div>

        <div class="card-menu">
          <%# Opens the channel's entries underneath this row, in place. The collapse
              controller is on the row, so the caret and the frame below it agree. %>
          <button type="button"
                  class="channel-card__expand section-toggle"
                  aria-expanded="false"
                  title="Show what is in this channel"
                  data-action="section-collapse#toggle">
            <i class="fa-solid fa-chevron-down section-caret" aria-hidden="true"></i>
          </button>
          <%= link_to list_path(list), title: 'Open this channel' do %>
            <i class="fa-solid fa-folder-open"></i>
          <% end %>
          <%= link_to new_list_entry_path(list), title: 'Add an entry' do %>
            <i class="fa-solid fa-circle-plus"></i>
          <% end %>
          <% if current_user&.can_edit_list?(list) %>
            <%= link_to edit_list_path(list), title: 'Edit this channel' do %>
              <i class="fa-solid fa-pen"></i>
            <% end %>
            <%# Takes it out of this channel rather than deleting it. %>
            <%= link_to list_move_to_list_path(list, remove_from: local_assigns[:parent]&.id),
                        data: { turbo_method: :patch,
                                turbo_confirm: "Remove #{list.name} from this channel?" },
                        title: 'Remove from this channel' do %>
              <i class="fa-solid fa-link-slash"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
